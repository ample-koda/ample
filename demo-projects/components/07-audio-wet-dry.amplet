composition "audio-wet-dry" { ample 1  tempo 100  master-seed 7 }

# A custom Audio component with a real subgraph: dry and wet branches mixed together, then a limiter after it.
import "components/wet-dry.amplec"

midi-clip melody at 1 for 2 {
  notes 1:0:1:60:100 1:1:1:64:100 1:2:1:67:100 2:0:2:72:100
}

piano lead at 1 for 2 {
  from melody.notes -> notes
}

koda.fx.wetDry blend {
  echo 0.75beat
  feedback 40%
  dryLevel -2dB
  wetLevel -10dB
  from lead.audio -> audio
}

limiter safety {
  from blend.audio -> in
}
