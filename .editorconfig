root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets}]
indent_style = space
indent_size = 4

[*.cs]
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0005.severity = warning

[*.{json,jsonc,yml,yaml,md,sh,ps1}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Line length: a guideline for the lines a change adds (see tools/check-long-lines.mjs; the hard limit is 200, html 240)
[*.{js,mjs,cjs,ts,cs,css}]
max_line_length = 140

[*.html]
max_line_length = 160
