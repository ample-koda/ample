{
  "$comment": "Golden vectors of the note pipelines (docs/language/12-note-pipelines.md). Run by the JavaScript evaluator (web/lib/test/note-pipeline.test.mjs) and the C# evaluator (tests/Ample.Core.Tests). Notes are compact text (bar:beat:length:pitch:velocity); span is in micro-beats (1 beat = 1000000, 1 bar = 4000000). warnings/errors are symbolic ids.",
  "defaults": {
    "tempo": 120,
    "sources": {
      "melody": "1:0:1:60:100 1:1:1:62:100 1:2:1:64:100 1:3:1:65:100 2:0:2:67:100",
      "a": "1:0:1:60:100",
      "b": "1:0:1:62:100",
      "x": "1:0:1:72:100",
      "m": "1:0:1:60:100 1:1:1:62:100 1:2:1:64:100 1:3:1:65:100 2:0:2:67:100",
      "chord": "1:0:2:60:100 1:0:2:64:100 1:0:2:67:100"
    },
    "master": "424242"
  },
  "cases": [
    { "id":  "reference passes the notes through", "expr": "melody.notes", "expect": {"notes": "1:0:1:60:100 1:1:1:62:100 1:2:1:64:100 1:3:1:65:100 2:0:2:67:100", "span": 8000000} },
    { "id":  "transpose up an octave", "expr": "melody.notes |> transpose(+12)", "expect": {"notes": "1:0:1:72:100 1:1:1:74:100 1:2:1:76:100 1:3:1:77:100 2:0:2:79:100", "span": 8000000} },
    { "id":  "transpose clamps the pitch to 127", "sources": {"hi": "1:0:1:125:100"}, "expr": "hi.notes |> transpose(+12)", "expect": {"notes": "1:0:1:127:100", "span": 4000000} },
    { "id":  "transpose clamps the semitones to 48", "sources": {"mid": "1:0:1:60:100"}, "expr": "mid.notes |> transpose(+60)", "expect": {"notes": "1:0:1:108:100", "span": 4000000} },
    { "id":  "bars is half-open and moves the window to the start", "expr": "melody.notes |> bars(2..3)", "expect": {"notes": "1:0:2:67:100", "span": 4000000} },
    { "id":  "bars with ..= includes the whole last bar", "expr": "melody.notes |> bars(1..=1)", "expect": {"notes": "1:0:1:60:100 1:1:1:62:100 1:2:1:64:100 1:3:1:65:100", "span": 4000000} },
    { "id":  "a fractional bar is a warning, not an error", "expr": "melody.notes |> bars(1..1.5)", "expect": {"notes": "1:0:1:60:100 1:1:1:62:100", "span": 2000000, "warnings": ["fractional-bar"]} },
    { "id":  "..= with a fraction reads as .. with the same warning", "expr": "melody.notes |> bars(1..=1.5)", "expect": {"notes": "1:0:1:60:100 1:1:1:62:100", "span": 2000000, "warnings": ["fractional-bar"]} },
    { "id":  "beats shortens a note that runs past the window", "sources": {"long": "1:0:3:60:100"}, "expr": "long.notes |> beats(1..3)", "expect": {"notes": "1:0:2:60:100", "span": 2000000} },
    { "id":  "time selects in seconds with the song tempo", "expr": "melody.notes |> time(0s..1s)", "expect": {"notes": "1:0:1:60:100 1:1:1:62:100", "span": 2000000} },
    { "id":  "time selects in milliseconds", "expr": "melody.notes |> time(500ms..1500ms)", "expect": {"notes": "1:0:1:62:100 1:1:1:64:100", "span": 2000000} },
    { "id":  "shift by a beat keeps the span", "expr": "melody.notes |> shift(+1beat)", "expect": {"notes": "1:1:1:60:100 1:2:1:62:100 1:3:1:64:100 2:0:1:65:100 2:1:2:67:100", "span": 8000000} },
    { "id":  "shift by milliseconds", "expr": "a.notes |> shift(+250ms)", "expect": {"notes": "1:0.5:1:60:100", "span": 4000000} },
    { "id":  "milliseconds round to a micro-beat", "tempo": 100, "expr": "a.notes |> shift(+1ms)", "expect": {"notes": "1:0.001667:1:60:100", "span": 4000000} },
    { "id":  "a shift past the span grows the span to whole bars", "expr": "a.notes |> shift(+5beats)", "expect": {"notes": "2:1:1:60:100", "span": 8000000} },
    { "id":  "merge grows the span to hold a later note", "sources": {"late": "3:0:1:64:100"}, "expr": "a.notes |> merge(late.notes)", "expect": {"notes": "1:0:1:60:100 3:0:1:64:100", "span": 12000000} },
    { "id":  "a half micro-beat rounds to even (down)", "expr": "a.notes |> shift(+0.0000005beat)", "expect": {"notes": "1:0:1:60:100", "span": 4000000} },
    { "id":  "one and a half micro-beats round to even (up)", "expr": "a.notes |> shift(+0.0000015beat)", "expect": {"notes": "1:0.000002:1:60:100", "span": 4000000} },
    { "id":  "a note that crosses a bar line is written as consecutive pieces, and the span grows to hold it", "expr": "a.notes |> shift(+3.5beats)", "expect": {"notes": "1:3.5:0.5:60:100;tie=1000000 2:0:0.5:60:100;tie=1000000", "span": 8000000} },
    { "id":  "notes shifted before the origin are dropped with a warning", "expr": "a.notes |> shift(-1beat)", "expect": {"notes": "", "span": 4000000, "warnings": ["before-origin"]} },
    { "id":  "concat puts the argument after the span", "expr": "a.notes |> concat(b.notes)", "expect": {"notes": "1:0:1:60:100 2:0:1:62:100", "span": 8000000} },
    { "id":  "merge layers two values, ordered by start then pitch", "expr": "a.notes |> merge(b.notes)", "expect": {"notes": "1:0:1:60:100 1:0:1:62:100", "span": 4000000} },
    { "id":  "remove deletes and leaves a gap", "expr": "melody.notes |> remove(bars(1..2))", "expect": {"notes": "2:0:2:67:100", "span": 8000000} },
    { "id":  "cut deletes and closes the gap", "expr": "melody.notes |> cut(bars(1..2))", "expect": {"notes": "1:0:2:67:100", "span": 4000000} },
    { "id":  "replace puts the argument in the range", "expr": "melody.notes |> replace(bars(1..2), x.notes)", "expect": {"notes": "1:0:1:72:100 2:0:2:67:100", "span": 8000000} },
    { "id":  "mask keeps positions and span", "expr": "melody.notes |> mask(bars(2..3))", "expect": {"notes": "2:0:2:67:100", "span": 8000000} },
    { "id":  "steps chain left to right", "expr": "melody.notes |> bars(1..2) |> transpose(+12)", "expect": {"notes": "1:0:1:72:100 1:1:1:74:100 1:2:1:76:100 1:3:1:77:100", "span": 4000000} },
    { "id":  "a literal is a source", "expr": "1:0:1:60:100 1:2:1:64:100 |> transpose(+1)", "expect": {"notes": "1:0:1:61:100 1:2:1:65:100", "span": 4000000} },
    { "id":  "unknown operator", "expr": "melody.notes |> transpos(1)", "expect": {"errors": ["unknown-operator"]} },
    { "id":  "reversed range", "expr": "melody.notes |> bars(4..2)", "expect": {"errors": ["range-reversed"]} },
    { "id":  "unknown reference", "expr": "nope.notes |> transpose(1)", "expect": {"errors": ["unknown-reference"]} },
    { "id":  "a length needs a unit", "expr": "a.notes |> shift(2)", "expect": {"errors": ["missing-unit"]} },
    { "id":  "reverse mirrors the notes inside the span", "sources": {"m": "1:0:1:60:100 1:1:1:62:100 2:0:2:67:100"}, "expr": "m.notes |> reverse()", "expect": {"notes": "1:2:2:67:100 2:2:1:62:100 2:3:1:60:100", "span": 8000000} },
    { "id":  "stretch 2 makes everything twice as slow", "expr": "a.notes |> stretch(2)", "expect": {"notes": "1:0:2:60:100", "span": 8000000} },
    { "id":  "stretch 0.5 halves the lengths (a value is never shorter than one bar)", "expr": "a.notes |> stretch(0.5)", "expect": {"notes": "1:0:0.5:60:100", "span": 4000000} },
    { "id":  "legato stretches each note to the next start", "sources": {"loose": "1:0:0.5:60:100 1:0.6:0.5:62:100 1:1.9:0.5:64:100"}, "expr": "loose.notes |> legato()", "expect": {"notes": "1:0:0.6:60:100 1:0.6:1.3:62:100 1:1.9:0.5:64:100", "span": 4000000} },
    { "id":  "quantize snaps the starts to the grid", "sources": {"loose": "1:0:0.5:60:100 1:0.6:0.5:62:100 1:1.9:0.5:64:100"}, "expr": "loose.notes |> quantize(0.5beat)", "expect": {"notes": "1:0:0.5:60:100 1:0.5:0.5:62:100 1:2:0.5:64:100", "span": 4000000} },
    { "id":  "humanize with an explicit seed is always the same", "sources": {"m": "1:0:1:60:100 1:1:1:62:100 1:2:1:64:100 1:3:1:65:100 2:0:2:67:100"}, "expr": "m.notes |> humanize(timing=20ms, velocity=4, seed=7)", "expect": {"notes": "1:0.029255:1:60:96 1:0.962777:1:62:102 1:1.968273:1:64:104 1:3.004748:0.995252:65:98;tie=1000000 2:0:0.004748:65:98;tie=1000000 2:0.029596:2:67:96", "span": 8000000} },
    { "id":  "humanize without a seed is refused", "expr": "a.notes |> humanize(timing=20ms)", "expect": {"errors": ["missing-seed"]} },
    { "id":  "repeat puts copies one after the other", "expr": "a.notes |> repeat(3)", "expect": {"notes": "1:0:1:60:100 2:0:1:60:100 3:0:1:60:100", "span": 12000000} },
    { "id":  "repeat is refused before it runs when it would pass the limit", "limit": 100, "expr": "a.notes |> repeat(1024) |> repeat(1024)", "expect": {"errors": ["cap-events"]} },
    { "id":  "arp spreads a chord over its length", "sources": {"chord": "1:0:2:60:100 1:0:2:64:100 1:0:2:67:100"}, "expr": "chord.notes |> arp(0.5beat)", "expect": {"notes": "1:0:0.5:60:100 1:0.5:0.5:64:100 1:1:0.5:67:100 1:1.5:0.5:60:100", "span": 4000000} },
    { "id":  "where keeps a half-open pitch range", "sources": {"m": "1:0:1:60:100 1:1:1:62:100 1:2:1:64:100 1:3:1:65:100"}, "expr": "m.notes |> where(pitch=62..65)", "expect": {"notes": "1:1:1:62:100 1:2:1:64:100", "span": 4000000} },
    { "id":  "where with ..= includes the end", "sources": {"m": "1:0:1:60:100 1:1:1:62:100 1:2:1:64:100 1:3:1:65:100"}, "expr": "m.notes |> where(pitch=62..=65)", "expect": {"notes": "1:1:1:62:100 1:2:1:64:100 1:3:1:65:100", "span": 4000000} },
    { "id":  "euclid makes a pattern as a source", "expr": "euclid(3, 8, pitch=36, step=0.5beat)", "expect": {"notes": "1:0:0.5:36:100 1:1.5:0.5:36:100 1:3:0.5:36:100", "span": 4000000} },
    { "id":  "euclid can be rotated", "expr": "euclid(3, 8, rotate=1)", "expect": {"notes": "1:2:1:36:100 2:1:1:36:100 2:3:1:36:100", "span": 8000000} },
    { "id":  "a generator can start a pipeline", "expr": "euclid(3, 8, step=0.5beat) |> transpose(+12)", "expect": {"notes": "1:0:0.5:48:100 1:1.5:0.5:48:100 1:3:0.5:48:100", "span": 4000000} },
    { "id":  "euclid needs hits and steps", "expr": "euclid(3)", "expect": {"errors": ["bad-argument"]} },
    { "id":  "humanize with an explicit seed is addressed by the notes, not by their order", "expr": "m.notes |> humanize(timing=20ms, velocity=4, seed=7)", "expect": {"notes": "1:0.029255:1:60:96 1:0.962777:1:62:102 1:1.968273:1:64:104 1:3.004748:0.995252:65:98;tie=1000000 2:0:0.004748:65:98;tie=1000000 2:0.029596:2:67:96", "span": 8000000} },
    { "id":  "humanize with a stable seed", "expr": "m.notes |> humanize(timing=20ms, velocity=4, seed=stable(\"verse\"))", "expect": {"notes": "1:0.010417:1:60:98 1:0.988688:1:62:98 1:2.018678:1:64:104 1:3.006523:0.993477:65:104;tie=1000000 2:0:0.006523:65:104;tie=1000000 2:0.038171:2:67:97", "span": 8000000} },
    { "id":  "a new master-seed gives a new variant of a stable seed", "master": "1", "expr": "m.notes |> humanize(timing=20ms, velocity=4, seed=stable(\"verse\"))", "expect": {"notes": "1:0.027327:1:60:103 1:0.983492:1:62:103 1:2.028997:1:64:102 1:3.008389:0.991611:65:96;tie=1000000 2:0:0.008389:65:96;tie=1000000 1:3.966652:0.033348:67:98;tie=1000001 2:0:1.966652:67:98;tie=1000001", "span": 8000000} },
    { "id":  "a new master-seed leaves an explicit seed as it was", "master": "1", "expr": "m.notes |> humanize(timing=20ms, velocity=4, seed=7)", "expect": {"notes": "1:0.029255:1:60:96 1:0.962777:1:62:102 1:1.968273:1:64:104 1:3.004748:0.995252:65:98;tie=1000000 2:0:0.004748:65:98;tie=1000000 2:0.029596:2:67:96", "span": 8000000} },
    { "id":  "an unrelated random step before does not shift a stable result (a)", "expr": "m.notes |> humanize(timing=20ms, seed=stable(\"a\"))", "expect": {"notes": "1:0:1:60:100 1:0.984825:1:62:100 1:1.990929:1:64:100 1:3.019034:0.980966:65:100;tie=1000000 2:0:0.019034:65:100;tie=1000000 2:0.03191:2:67:100", "span": 8000000} },
    { "id":  "an unrelated random step before does not shift a stable result (b)", "expr": "m.notes |> transpose(random(0..=0, seed=stable(\"noise\"))) |> thin(0, seed=stable(\"other\")) |> humanize(timing=20ms, seed=stable(\"a\"))", "expect": {"notes": "1:0:1:60:100 1:0.984825:1:62:100 1:1.990929:1:64:100 1:3.019034:0.980966:65:100;tie=1000000 2:0:0.019034:65:100;tie=1000000 2:0.03191:2:67:100", "span": 8000000} },
    { "id":  "adding a note elsewhere does not move the draw of the others", "sources": {"more": "1:0:1:60:100 1:1:1:62:100 1:2:1:64:100 1:3:1:65:100 2:0:2:67:100 3:0:1:72:100"}, "expr": "more.notes |> humanize(timing=20ms, seed=stable(\"a\"))", "expect": {"notes": "1:0:1:60:100 1:0.984825:1:62:100 1:1.990929:1:64:100 1:3.019034:0.980966:65:100;tie=1000000 2:0:0.019034:65:100;tie=1000000 2:0.03191:2:67:100 3:0.038569:1:72:100", "span": 12000000} },
    { "id":  "random value: the same seed and round give the same value (round 0)", "expr": "m.notes |> transpose(random(-12..=12, seed=stable(\"verse\").fork(\"pitch\"), round=0))", "expect": {"notes": "1:0:1:52:100 1:1:1:54:100 1:2:1:56:100 1:3:1:57:100 2:0:2:59:100", "span": 8000000} },
    { "id":  "random value: round 0 again, written another way", "expr": "m.notes |> transpose(random(-12..=12, round=0, seed=stable(\"verse\").fork(\"pitch\")))", "expect": {"notes": "1:0:1:52:100 1:1:1:54:100 1:2:1:56:100 1:3:1:57:100 2:0:2:59:100", "span": 8000000} },
    { "id":  "random value: another round gives another value", "expr": "m.notes |> transpose(random(-12..=12, seed=stable(\"verse\").fork(\"pitch\"), round=1))", "expect": {"notes": "1:0:1:67:100 1:1:1:69:100 1:2:1:71:100 1:3:1:72:100 2:0:2:74:100", "span": 8000000} },
    { "id":  "random value: another fork gives another family", "expr": "m.notes |> transpose(random(-12..=12, seed=stable(\"verse\").fork(\"rhythm\"), round=0))", "expect": {"notes": "1:0:1:53:100 1:1:1:55:100 1:2:1:57:100 1:3:1:58:100 2:0:2:60:100", "span": 8000000} },
    { "id":  "random value: a fork label that is a number is not the same as a name", "expr": "m.notes |> transpose(random(-12..=12, seed=stable(\"verse\").fork(3), round=0))", "expect": {"notes": "1:0:1:55:100 1:1:1:57:100 1:2:1:59:100 1:3:1:60:100 2:0:2:62:100", "span": 8000000} },
    { "id":  "random value: the same fork written nested gives the same family", "expr": "m.notes |> transpose(random(-12..=12, seed=stable(\"verse\").fork(\"pitch\").fork(\"a\"), round=0))", "expect": {"notes": "1:0:1:55:100 1:1:1:57:100 1:2:1:59:100 1:3:1:60:100 2:0:2:62:100", "span": 8000000} },
    { "id":  "random length in milliseconds", "expr": "m.notes |> shift(random(10ms..=40ms, seed=stable(\"verse\"), round=0))", "expect": {"notes": "1:0.065668:1:60:100 1:1.065668:1:62:100 1:2.065668:1:64:100 1:3.065668:0.934332:65:100;tie=1000000 2:0:0.065668:65:100;tie=1000000 2:0.065668:2:67:100", "span": 8000000} },
    { "id":  "choose one of a list", "expr": "m.notes |> transpose(choose(0, 3, 7, 12, seed=stable(\"verse\"), round=2))", "expect": {"notes": "1:0:1:72:100 1:1:1:74:100 1:2:1:76:100 1:3:1:77:100 2:0:2:79:100", "span": 8000000} },
    { "id":  "chance gives 1 or 0 for a round (round 0)", "expr": "m.notes |> transpose(chance(0.5, seed=stable(\"verse\"), round=0))", "expect": {"notes": "1:0:1:60:100 1:1:1:62:100 1:2:1:64:100 1:3:1:65:100 2:0:2:67:100", "span": 8000000} },
    { "id":  "chance gives 1 or 0 for a round (round 1)", "expr": "m.notes |> transpose(chance(0.5, seed=stable(\"verse\"), round=1))", "expect": {"notes": "1:0:1:60:100 1:1:1:62:100 1:2:1:64:100 1:3:1:65:100 2:0:2:67:100", "span": 8000000} },
    { "id":  "chance gives 1 or 0 for a round (round 2)", "expr": "m.notes |> transpose(chance(0.5, seed=stable(\"verse\"), round=2))", "expect": {"notes": "1:0:1:60:100 1:1:1:62:100 1:2:1:64:100 1:3:1:65:100 2:0:2:67:100", "span": 8000000} },
    { "id":  "thin drops notes by chance, per note", "expr": "m.notes |> thin(0.5, seed=stable(\"verse\"))", "expect": {"notes": "1:0:1:60:100 1:1:1:62:100 1:2:1:64:100", "span": 8000000} },
    { "id":  "thin per bar drops or keeps whole bars", "expr": "m.notes |> thin(0.5, seed=stable(\"verse\"), per=bar)", "expect": {"notes": "1:0:1:60:100 1:1:1:62:100 1:2:1:64:100 1:3:1:65:100", "span": 8000000} },
    { "id":  "randomize sets the velocity and the pitch inside ranges", "expr": "m.notes |> randomize(velocity=70..=95, pitch=-2..=2, seed=stable(\"verse\"))", "expect": {"notes": "1:0:1:59:76 1:1:1:63:85 1:2:1:63:77 1:3:1:64:84 2:0:2:68:83", "span": 8000000} },
    { "id":  "scramble moves the pitches among the notes", "expr": "m.notes |> scramble(seed=stable(\"verse\"))", "expect": {"notes": "1:0:1:64:100 1:1:1:62:100 1:2:1:67:100 1:3:1:65:100 2:0:2:60:100", "span": 8000000} },
    { "id":  "walk makes a melody on a scale from a seed", "expr": "walk(C, major, steps=8, step=0.5beat, seed=stable(\"melody\"))", "expect": {"notes": "1:0:0.5:60:100 1:0.5:0.5:64:100 1:1:0.5:60:100 1:1.5:0.5:59:100 1:2:0.5:55:100 1:2.5:0.5:59:100 1:3:0.5:59:100 1:3.5:0.5:55:100", "span": 4000000} },
    { "id":  "walk with another seed is another melody", "expr": "walk(C, major, steps=8, step=0.5beat, seed=stable(\"melody\").fork(\"b\"))", "expect": {"notes": "1:0:0.5:60:100 1:0.5:0.5:64:100 1:1:0.5:65:100 1:1.5:0.5:64:100 1:2:0.5:67:100 1:2.5:0.5:69:100 1:3:0.5:72:100 1:3.5:0.5:76:100", "span": 4000000} },
    { "id":  "chords makes notes from chord symbols", "expr": "chords(\"Am F C G7\")", "expect": {"notes": "1:0:4:69:90 1:0:4:72:90 1:0:4:76:90 2:0:4:65:90 2:0:4:69:90 2:0:4:72:90 3:0:4:60:90 3:0:4:64:90 3:0:4:67:90 4:0:4:67:90 4:0:4:71:90 4:0:4:74:90 4:0:4:77:90", "span": 16000000} },
    { "id":  "chords takes length, octave and velocity in that order without names", "expr": "chords(\"Am F\", 1bar, 3, 70)", "expect": {"notes": "1:0:4:57:70 1:0:4:60:70 1:0:4:64:70 2:0:4:53:70 2:0:4:57:70 2:0:4:60:70", "span": 8000000} },
    { "id":  "chords refuses a value without a name that has no slot left", "expr": "chords(\"Am F\", 1bar, length=2bar)", "expect": {"errors": ["bad-argument"]} },
    { "id":  "chords with a length and an octave", "expr": "chords(\"Cmaj7 Dm7\", length=2beats, octave=3, velocity=80)", "expect": {"notes": "1:0:2:48:80 1:0:2:52:80 1:0:2:55:80 1:0:2:59:80 1:2:2:50:80 1:2:2:53:80 1:2:2:57:80 1:2:2:60:80", "span": 4000000} },
    { "id":  "scale makes a run on a scale", "expr": "scale(D, dorian, steps=8, step=0.25beat, octave=3)", "expect": {"notes": "1:0:0.25:50:100 1:0.25:0.25:52:100 1:0.5:0.25:53:100 1:0.75:0.25:55:100 1:1:0.25:57:100 1:1.25:0.25:59:100 1:1.5:0.25:60:100 1:1.75:0.25:62:100", "span": 4000000} },
    { "id":  "clamp caps the notes at a ceiling and a floor", "expr": "m.notes |> transpose(+6) |> clamp(55..=68)", "expect": {"notes": "1:0:1:66:100 1:1:1:68:100 1:2:1:68:100 1:3:1:68:100 2:0:2:68:100", "span": 8000000} },
    { "id":  "fold moves notes by octaves into a range", "expr": "m.notes |> transpose(+14) |> fold(55..=66)", "expect": {"notes": "1:0:1:62:100 1:1:1:64:100 1:2:1:66:100 1:3:1:55:100 2:0:2:57:100", "span": 8000000} },
    { "id":  "snap moves notes to the nearest scale tone", "sources": {"odd": "1:0:1:61:100 1:1:1:63:100 1:2:1:66:100"}, "expr": "odd.notes |> snap(C, major)", "expect": {"notes": "1:0:1:60:100 1:1:1:62:100 1:2:1:65:100", "span": 4000000} },
    { "id":  "keep keeps only the notes of a scale", "sources": {"odd": "1:0:1:61:100 1:1:1:62:100 1:2:1:66:100 1:3:1:67:100"}, "expr": "odd.notes |> keep(C, major)", "expect": {"notes": "1:1:1:62:100 1:3:1:67:100", "span": 4000000} },
    { "id":  "avoid keeps the notes that are not in a scale", "sources": {"odd": "1:0:1:61:100 1:1:1:62:100 1:2:1:66:100 1:3:1:67:100"}, "expr": "odd.notes |> avoid(C, major)", "expect": {"notes": "1:0:1:61:100 1:2:1:66:100", "span": 4000000} },
    { "id":  "a random-stream gives its values in order (shift then transpose)", "streams": {"drift": "stable(\"verse\").fork(\"drift\")"}, "expr": "m.notes |> shift(drift.next(0ms..=30ms)) |> transpose(drift.next(-2..=2))", "expect": {"notes": "1:0.019343:1:62:100 1:1.019343:1:64:100 1:2.019343:1:66:100 1:3.019343:0.980657:67:100;tie=1000000 2:0:0.019343:67:100;tie=1000000 2:0.019343:2:69:100", "span": 8000000} },
    { "id":  "the second next() of a stream is random(round=1) of the same seed", "expr": "m.notes |> shift(random(0ms..=30ms, seed=stable(\"verse\").fork(\"drift\"), round=0)) |> transpose(random(-2..=2, seed=stable(\"verse\").fork(\"drift\"), round=1))", "expect": {"notes": "1:0.019343:1:62:100 1:1.019343:1:64:100 1:2.019343:1:66:100 1:3.019343:0.980657:67:100;tie=1000000 2:0:0.019343:67:100;tie=1000000 2:0.019343:2:69:100", "span": 8000000} },
    { "id":  "a stream needs a declaration", "expr": "m.notes |> transpose(drift.next(-2..=2))", "expect": {"errors": ["stream-error"]} },
    { "id":  "a plain seed has no next()", "expr": "m.notes |> transpose(stable(\"x\").next(-2..=2))", "expect": {"errors": ["stream-error"]} },
    { "id":  "a stream is not a seed", "streams": {"drift": "stable(\"x\")"}, "expr": "m.notes |> humanize(timing=10ms, seed=drift)", "expect": {"errors": ["stream-error"]} },
    { "id":  "a random-seed() that was not picked refuses to run", "expr": "m.notes |> humanize(timing=10ms, seed=random-seed())", "expect": {"errors": ["unresolved-random-seed"]} },
    { "id":  "a seed must be a number or stable(...)", "expr": "m.notes |> humanize(timing=10ms, seed=0.5)", "expect": {"errors": ["seed-error"]} },
    { "id":  "a seeded operator without a seed is refused", "expr": "m.notes |> scramble()", "expect": {"errors": ["missing-seed"]} },
    { "id":  "a chord symbol that does not exist", "expr": "chords(\"Am H\")", "expect": {"errors": ["bad-argument"]} },
    { "id":  "an unknown scale", "expr": "scale(C, nope)", "expect": {"errors": ["bad-argument"]} },
    { "id":  "the same seed used twice by the same operator is noted", "expr": "m.notes |> humanize(timing=10ms, seed=stable(\"a\")) |> humanize(timing=10ms, seed=stable(\"a\"))", "expect": {"notes": "1:0:1:60:100 1:1.032574:1:62:100 1:2.008521:1:64:100 1:2.980631:1:65:100 2:0.037873:2:67:100", "span": 8000000, "warnings": ["same-seed"]} },
    { "id":  "fold needs an octave of room", "expr": "m.notes |> fold(60..=64)", "expect": {"errors": ["bad-argument"]} },
    { "id":  "set puts a cycle of pitches and velocities on the notes", "expr": "m.notes |> set(pitch=\"38 C3\", velocity=\"105 82\")", "expect": {"notes":"1:0:1:38:105 1:1:1:48:82 1:2:1:38:105 1:3:1:48:82 2:0:2:38:105","span":8000000} },
    { "id":  "set can write every setting of a note", "expr": "a.notes |> set(pan=20, fine=-5, rel=300, cut=80, slide=1, port=40, bend=100, channel=9, bank=128, program=0)", "expect": {"notes":"1:0:1:60:100:9:128:0;pan=20;fine=-5;rel=300;cut=80;slide=1;port=40;bend=100","span":4000000} },
    { "id":  "set leaves out a setting that is the default", "expr": "a.notes |> set(pan=0, cut=100)", "expect": {"notes":"1:0:1:60:100","span":4000000} },
    { "id":  "a note over a bar line is written as pieces that are tied", "expr": "a.notes |> shift(3.5beat)", "expect": {"notes":"1:3.5:0.5:60:100;tie=1000000 2:0:0.5:60:100;tie=1000000","span":8000000} },
    { "id":  "set refuses a value out of range", "expr": "a.notes |> set(program=300)", "expect": {"errors":["bad-argument"]} },
    { "id":  "set needs something to set", "expr": "a.notes |> set()", "expect": {"errors":["bad-argument"]} },
    { "id":  "set refuses an unknown name", "expr": "a.notes |> set(colour=1)", "expect": {"errors":["bad-argument"]} },
    { "id":  "set can take the release and the routing of a note away", "expr": "1:0:1:60:100:9:128:0;rel=300;pan=5 |> set(rel=-1, channel=-1)", "expect": {"notes":"1:0:1:60:100;pan=5","span":4000000} }
  ]
}
