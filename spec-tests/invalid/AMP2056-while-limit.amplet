composition "x" { ample 1  tempo 120  master-seed 1 }

helper grow(Notes n) -> Notes {
  var r = n
  while count(r) < 100 max 2 {
    r = r |> merge(n |> shift(span(r)))
  }
  return r
}

midi-clip a at 1 for 1 {
  notes "1:0:1:60:100 1:1:1:62:100"
}

midi-clip b at 2 for auto {
  notes grow(a.notes)
}
