{
  "comment": "Lexical facts for spec version 0.1 (provisional).",
  "lineComment": "#",
  "ignoreDirective": "ample-ignore",
  "keywords": ["composition", "ample", "project", "features", "lint", "layout", "use", "tempo", "meter", "master-seed", "at", "for", "as", "from", "bake", "lock", "refresh", "disabled", "freeze", "seeds", "plan", "stable", "pinned", "live", "on", "off", "assist", "diff", "button", "auto", "info", "warning", "error"],
  "modules": ["quality", "credits", "signing", "secrets", "lyrics", "git-mirror"],
  "assistLevels": ["off", "diff", "button", "auto"],
  "lintLevels": ["off", "info", "warning", "error"],
  "operators": ["{", "}", ",", ".", "->", "@"],
  "patterns": {
    "identifier": "[A-Za-z0-9_-]+",
    "string": "\"(?:[^\"\\\\]|\\\\.)*\"",
    "integer": "[0-9]+",
    "number": "[0-9]+(?:\\.[0-9]+)?",
    "classVersion": "(stable|pinned|live)@[0-9]+(?:\\.[0-9]+)*",
    "ruleCode": "L[0-9]{3}",
    "diagnosticCode": "AMP[0-9]{4}"
  },
  "limits": { "tempo": [20, 300], "seed": [0, 18446744073709551615], "maxBar": 1024 }
}
