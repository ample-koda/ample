{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "analysis-spectrum",
  "title": "Spectral summary",
  "type": "object",
  "required": [
    "centroidHz",
    "rolloffHz",
    "flatness",
    "bands"
  ],
  "properties": {
    "centroidHz": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "rolloffHz": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "flatness": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "bands": {
      "type": "object",
      "required": [
        "low",
        "mid",
        "high",
        "air"
      ],
      "properties": {
        "low": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mid": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "high": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "air": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
