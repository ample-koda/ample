{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "analysis-tempo",
  "title": "Tempo analysis",
  "type": "object",
  "required": [
    "bpm",
    "confidence",
    "beatSeconds",
    "firstBeatSeconds"
  ],
  "properties": {
    "bpm": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 70,
      "maximum": 180
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "beatSeconds": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "firstBeatSeconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    }
  }
}
