{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "analysis-pitch",
  "title": "Pitch contour",
  "type": "object",
  "required": [
    "hopSeconds",
    "voicedFrames",
    "frames"
  ],
  "properties": {
    "hopSeconds": {
      "type": "number",
      "minimum": 0
    },
    "voicedFrames": {
      "type": "integer",
      "minimum": 0
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "t",
          "hz",
          "midi",
          "confidence"
        ],
        "properties": {
          "t": {
            "type": "number",
            "minimum": 0
          },
          "hz": {
            "type": "number",
            "minimum": 20,
            "maximum": 4000
          },
          "midi": {
            "type": "number"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
