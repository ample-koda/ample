{
  "type": "object",
  "required": ["diagnostics"],
  "additionalProperties": false,
  "properties": {
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "title", "explanation", "wrongExample", "rightExample", "since", "retired"],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string", "pattern": "^(AMP[0-9]{4}|AMPL[0-9]{3})$" },
          "severity": { "enum": ["error", "warning", "info"] },
          "title": { "type": "string" },
          "explanation": { "type": "string" },
          "wrongExample": { "type": "string" },
          "rightExample": { "type": "string" },
          "since": { "type": "string" },
          "retired": { "type": "boolean" },
          "stage": { "enum": ["static", "runtime"] },
          "deprecated": { "type": "string" }
        }
      }
    }
  }
}
