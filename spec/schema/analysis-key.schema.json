{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "analysis-key",
  "title": "Key analysis",
  "type": "object",
  "required": [
    "key",
    "tonic",
    "mode",
    "confidence",
    "chroma",
    "candidates"
  ],
  "properties": {
    "key": {
      "type": [
        "string",
        "null"
      ]
    },
    "tonic": {
      "type": [
        "string",
        "null"
      ]
    },
    "mode": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "major",
        "minor",
        null
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "chroma": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "score"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "score": {
            "type": "number"
          }
        }
      }
    }
  }
}
