composition "Chorus preview" { ample 1  tempo 96  master-seed 17 }

midi-clip phrase {
  chords C Am F G
  bars 4
}

synth source {
  wave triangle
  gain -9 dB
  from phrase.notes -> notes
}

chorus widen {
  depth 5 ms
  period 1500 ms
  mix 50 %
  from source.audio -> audio
}

master master {
  from widen.audio -> audio
}
