composition "Tremolo preview" { ample 1  tempo 96  master-seed 17 }

midi-clip phrase {
  chords C Am F G
  bars 4
}

synth source {
  wave triangle
  gain -9 dB
  from phrase.notes -> notes
}

tremolo pulse {
  mode tremolo
  sync 1/8
  depth 60
  shape triangle
  phase 0
  from source.audio -> audio
}

master master {
  from pulse.audio -> audio
}
