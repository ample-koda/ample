composition "Scratch preview" { ample 1  tempo 96 master-seed 17 }

midi-clip phrase {
  chords C Am F G
  bars 4
}

synth source {
  wave triangle
  gain -9 dB
  from phrase.notes -> notes
}

scratch scratch_phrase {
  pattern x...b...f...r...
  depth 120 ms
  mix 65%
  from source.audio -> audio
}

master master {
  from scratch_phrase.audio -> audio
}
