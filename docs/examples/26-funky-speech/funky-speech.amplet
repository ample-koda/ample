  notes "1:0:0.75:69:112 1:0.75:0.75:69:112 1:1.5:0.75:67:112 1:2.5:1.25:69:112 2:0:0.75:69:112 2:0.75:0.75:67:112 2:1.5:0.75:64:112 2:2.5:1.5:64:112 3:0:0.75:69:112 3:0.75:0.5:69:112 3:1.5:0.5:67:112 3:2:1.5:64:112 4:0:0.75:69:112 4:0.75:0.5:69:112 4:1.25:0.5:67:112 4:2:2:64:112 5:0:0.75:67:112 5:0.75:0.75:67:112 5:1.5:0.75:69:112 5:2.25:0.75:71:112 5:3:1:69:112 6:0:1.5:67:112 6:1.5:1.5:64:112 7:0:1.5:69:112 7:1.5:1.5:69:112 7:3:1:67:112 8:0:1:64:112 8:1:3:64:112"
}
midi-clip break_melody at 23 for 2 {
  notes "1:0:1:64:112 1:1.5:1:64:112 1:2.5:1:67:112 2:0:1:64:112 2:1:1.5:67:112 2:2.5:1:64:112"
}
midi-clip chorus2_melody at 25 for 8 {
  notes "1:0:0.75:69:112 1:0.75:0.75:69:112 1:1.5:0.75:67:112 1:2.5:1.25:69:112 2:0:0.75:69:112 2:0.75:0.75:67:112 2:1.5:0.75:64:112 2:2.5:1.5:64:112 3:0:0.75:69:112 3:0.75:0.5:69:112 3:1.5:0.5:67:112 3:2:1.5:64:112 4:0:0.75:69:112 4:0.75:0.5:69:112 4:1.25:0.5:67:112 4:2:2:64:112 5:0:0.75:67:112 5:0.75:0.75:67:112 5:1.5:0.75:69:112 5:2.25:0.75:71:112 5:3:1:69:112 6:0:1.5:67:112 6:1.5:1.5:64:112 7:0:1.5:69:112 7:1.5:1.5:69:112 7:3:1:67:112 8:0:1:64:112 8:1:3:64:112"
}
midi-clip outro_melody at 33 for 2 {
  notes "1:0:1:64:112 1:1.5:0.75:67:112 1:2.5:1.5:69:112 2:0.5:1:67:112 2:2:0.75:64:112 2:3:1:59:112"
}

speech verse_words at 5 for 8 {
  mode "words"
  text "Check the clock its time to move Leave the worries by the door Bass line calling feel the groove Nobody here is keeping score"
  duration_policy "fit"
  gain 12
  from verse_melody.notes -> notes
}
speech chorus_words at 13 for 8 {
  mode "words"
  text "Get down get funky get up get loud Dance with the robots dance with the crowd One more time now take it higher Funky funky light the fire"
  duration_policy "fit"
  gain 12
  from chorus_melody.notes -> notes
}
speech break_words at 23 for 2 {
  mode "words"
  text "Hold it hold it now go"
  duration_policy "fit"
  gain 12
  from break_melody.notes -> notes
}
speech chorus2_words at 25 for 8 {
  mode "words"
  text "Get down get funky get up get loud Dance with the robots dance with the crowd One more time now take it higher Funky funky never stop"
  duration_policy "fit"
  gain 12
  from chorus2_melody.notes -> notes
}
speech outro_words at 33 for 2 {
  mode "words"
  text "Thats the groove see you later"
  duration_policy "fit"
  gain 12
  from outro_melody.notes -> notes
}

mixer voice_in {
  from verse_words.audio -> audio1
  from chorus_words.audio -> audio2
  from break_words.audio -> audio3
  from chorus2_words.audio -> audio4
  from outro_words.audio -> audio5
  gains 21 21 21 21 21
  pan c c c c c
}
autotune voice_tune {
  method spectral
  key "E dorian"
  speed 10 ms
  amount 100%
  humanize 20%
  vibrato keep
  from voice_in.audio -> audio
}
filter voice_clean {
  type highpass
  cutoff 140 Hz
  from voice_tune.audio -> audio
}
eq voice_clarity {
  low -2 dB
  mid 1 dB
  high 4 dB
  low_hz 200 Hz
  high_hz 2800 Hz
  from voice_clean.audio -> audio
}
distortion voice_bite {
  drive 8 dB
  mode soft
  tone 9000 Hz
  level 0 dB
  mix 15%
  from voice_clarity.audio -> audio
}
delay voice_echo {
  time 283 ms
  feedback 24%
  mix 16%
  from voice_bite.audio -> audio
}
reverb voice_room {
  size 28%
  decay 24%
  mix 12%
  from voice_echo.audio -> audio
}

# ---- the mix: a glue compressor, the fade-out and the master ----
mixer mix {
  from drums.audio -> audio1
  from bass.audio -> audio2
  from clav.audio -> audio3
  from guitar.audio -> audio4
  from keys.audio -> audio5
  from horns.audio -> audio6
  from voice_room.audio -> audio7
  gains -3 -3 0 0 0 0 1
  pan c c l r c c c
}
compressor mastercomp {
  threshold -18 dB
  ratio 2.2
  attack 25 ms
  release 200 ms
  makeup 4 dB
  from mix.audio -> audio
}
volume finale {
  from mastercomp.audio -> audio
  gain fadeout(38, 3, exp)
}
master master {
  from finale.audio -> audio
}
