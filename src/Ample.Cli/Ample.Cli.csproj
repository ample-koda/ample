<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ample</ToolCommandName>
    <PackageId>Ample.Cli</PackageId>
    <!-- The Playwright driver (a Node program for five platforms, 560 MB) is NOT part of the program or its packages: Koda's browser is the optional pack
         koda-browser (ample packs install koda-browser). 'none' is the switch of Microsoft.Playwright's build targets that copies no driver at all. -->
    <PlaywrightPlatform>none</PlaywrightPlatform>
    <!-- Microsoft.Playwright still copies its small playwright.ps1 next to the program, which NuGet does not run on install (NU5111); warnings are errors in this repository. -->
    <NoWarn>$(NoWarn);NU5111</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Ample.Cli.Tests" />
    <!-- the catalog of the downloadable sample packs with the SHA-256 of every zip (made by tools/build-sample-pack-zips.mjs) -->
    <EmbeddedResource Include="../../audio-packs/packs-index.json" LogicalName="audio-packs-index.json" />
    <PackageReference Include="System.CommandLine" />
    <ProjectReference Include="../Ample.Engine/Ample.Engine.csproj" />
    <ProjectReference Include="../Ample.Docs/Ample.Docs.csproj" />
    <ProjectReference Include="../Ample.Lsp/Ample.Lsp.csproj" />
    <ProjectReference Include="../Ample.Plugins/Ample.Plugins.csproj" />
    <ProjectReference Include="../Ample.Server/Ample.Server.csproj" />
  </ItemGroup>
</Project>
