<Project>
  <Import Project="../Directory.Build.props" />
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Ample.Golden' and '$(MSBuildProjectName)' != 'Ample.Testing'">
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
