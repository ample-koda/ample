<Project>
  <Import Project="../Directory.Build.props" />
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1707</NoWarn>
    <!-- Verify looks for a solution file to scrub paths; the public repository has none, so name the folder -->
    <SolutionDir>$(MSBuildThisFileDirectory)../</SolutionDir>
    <SolutionName>Ample</SolutionName>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Ample.Golden' and '$(MSBuildProjectName)' != 'Ample.Testing'">
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
