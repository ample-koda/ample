<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><IsTestProject>true</IsTestProject></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <!-- the browser tests need a driver: they get their own (the server and the program carry none) -->
    <PackageReference Include="Microsoft.Playwright" />
    <!-- the connection layer of the Visual Studio extension (plain classes, no Visual Studio types) is tested here, compiled from its sources -->
    <Compile Include="../../editors/visualstudio/src/Ample.ProjectSystem/Remote/*.cs" LinkBase="VsRemote" />
    <Compile Include="../../editors/visualstudio/src/Ample.ProjectSystem/AmpleCli.cs" LinkBase="VsRemote" />
    <ProjectReference Include="../../src/Ample.Server/Ample.Server.csproj" />
    <ProjectReference Include="../../src/Ample.Engine/Ample.Engine.csproj" />
  </ItemGroup>
</Project>
