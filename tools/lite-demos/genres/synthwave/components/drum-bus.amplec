/** Four drum groups in, one drum bus out: a level for each group, glue compression, a little drive. */
#[DisplayName("Drum bus")]
#[Category("Synthwave")]
#[Tags("drums", "bus", "glue", "compressor", "synthwave")]
component koda.synthwave.drumBus version 1.0.0 current {
  id "demo.koda.synthwave.drum-bus"

  input kick: Audio
  input snare: Audio
  input hats: Audio
  input perc: Audio

  #[DisplayName("Kick"), MinValue(-18dB), MaxValue(9dB)]
  property kickLevel: Gain = 1dB
  #[DisplayName("Snare"), MinValue(-18dB), MaxValue(9dB)]
  property snareLevel: Gain = 1dB
  #[DisplayName("Hats"), MinValue(-24dB), MaxValue(9dB)]
  property hatLevel: Gain = -8dB
  #[DisplayName("Perc"), MinValue(-24dB), MaxValue(9dB)]
  property percLevel: Gain = -5dB
  #[DisplayName("Glue"), MinValue(-30dB), MaxValue(0dB)]
  property glue: Gain = -14dB
  #[DisplayName("Drive"), MinValue(0dB), MaxValue(18dB)]
  property drive: Gain = 4dB

  output audio: Audio

  ui {
    group "Levels" tint blue {
      row {
        knob kickLevel tint red
        knob snareLevel tint orange
        knob hatLevel tint yellow
        knob percLevel tint teal
      }
    }
    group "Bus" tint purple {
      row {
        knob glue size l
        knob drive size l tint red
      }
    }
    card {
      knob glue size s
      knob drive size s tint red
    }
  }

  process {
    let k = kick |> gain(kickLevel)
    let s = snare |> gain(snareLevel)
    let h = hats |> gain(hatLevel)
    let p = perc |> gain(percLevel)
    emit mix(k, s, h, p)
      |> compressor(threshold=glue, ratio=3, attack=12ms, release=90ms)
      |> distortion(drive=drive, mode="soft", tone=9000Hz, mix=18%)
      |> eq(low=1dB, high=1dB)
  }
}
