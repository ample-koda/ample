composition "lo-fi" { ample 1  tempo 80  master-seed 80 }

# LO-FI: lo-fi chill, 44 bars at 80 BPM (2:12), made of custom components.
#
#   bars  1- 4  intro
#   bars  5-20  a
#   bars 21-32  b
#   bars 33-40  a2
#   bars 41-44  outro
#
# Components (techno-style: Notes components arrange the riffs, instruments are Notes in / sound out, the rest are audio components): loopBars, arrange, lofiBass, lofiKeys, vinylPad, lofiLead, drumBus, master.
# The drums need the kit in samples/kit (kick, snare, hat, open, tom).
import "Testjes/Components/lofi/components/loop-bars.amplec"
import "Testjes/Components/lofi/components/arrange.amplec"
import "Testjes/Components/lofi/components/lofi-bass.amplec"
import "Testjes/Components/lofi/components/lofi-keys.amplec"
import "Testjes/Components/lofi/components/vinyl-pad.amplec"
import "Testjes/Components/lofi/components/lofi-lead.amplec"
import "Testjes/Components/lofi/components/drum-bus.amplec"
import "Testjes/Components/lofi/components/master.amplec"

# ------------------------------------------------------------------ riffs, loops and the arrangement of every instrument
midi-clip lofiBassRiff at 1 for 4 {
  notes 1:0:1.5:29:98 1:2:1:36:90 1:3.25:0.5:34:84 2:0:1.5:28:98 2:2:1:35:90 2:3.25:0.5:33:84 3:0:1.5:26:98 3:2:1:33:90 3:3.25:0.5:31:84 4:0:1.5:31:98 4:2:1:38:90 4:3.25:0.5:36:84
}

koda.lofi.loopBars lofiBassLoop1 at 1 for 36 {
  times 9
  from lofiBassRiff.notes -> source
}

koda.lofi.arrange lofiBassPlan at 1 for 44 {
  s1 4bar
  from lofiBassLoop1.notes -> p1
}

koda.lofi.lofiBass lofiBass at 1 for 44 {
  from lofiBassPlan.notes -> notes
}

midi-clip lofiKeysRiff at 1 for 4 {
  notes 1:0:1.5:53:84 1:0:1.5:57:84 1:0:1.5:60:84 1:0:1.5:64:84 1:1.75:0.5:53:70 1:1.75:0.5:57:70 1:1.75:0.5:60:70 1:1.75:0.5:64:70 1:2.5:1:53:80 1:2.5:1:57:80 1:2.5:1:60:80 1:2.5:1:64:80 2:0:1.5:52:84 2:0:1.5:55:84 2:0:1.5:59:84 2:0:1.5:62:84 2:1.75:0.5:52:70 2:1.75:0.5:55:70 2:1.75:0.5:59:70 2:1.75:0.5:62:70 2:2.5:1:52:80 2:2.5:1:55:80 2:2.5:1:59:80 2:2.5:1:62:80 3:0:1.5:50:84 3:0:1.5:53:84 3:0:1.5:57:84 3:0:1.5:60:84 3:1.75:0.5:50:70 3:1.75:0.5:53:70 3:1.75:0.5:57:70 3:1.75:0.5:60:70 3:2.5:1:50:80 3:2.5:1:53:80 3:2.5:1:57:80 3:2.5:1:60:80 4:0:1.5:55:84 4:0:1.5:59:84 4:0:1.5:62:84 4:0:1.5:65:84 4:1.75:0.5:55:70 4:1.75:0.5:59:70 4:1.75:0.5:62:70 4:1.75:0.5:65:70 4:2.5:1:55:80 4:2.5:1:59:80 4:2.5:1:62:80 4:2.5:1:65:80
}

koda.lofi.loopBars lofiKeysLoop1 at 1 for 44 {
  times 11
  from lofiKeysRiff.notes -> source
}

koda.lofi.arrange lofiKeysPlan at 1 for 44 {
  s1 0bar
  from lofiKeysLoop1.notes -> p1
}

koda.lofi.lofiKeys lofiKeys at 1 for 44 {
  from lofiKeysPlan.notes -> notes
}

midi-clip vinylPadRiff at 1 for 4 {
  notes 1:0:4:53:60 1:0:4:57:60 1:0:4:60:60 1:0:4:64:60 2:0:4:52:60 2:0:4:55:60 2:0:4:59:60 2:0:4:62:60 3:0:4:50:60 3:0:4:53:60 3:0:4:57:60 3:0:4:60:60 4:0:4:55:60 4:0:4:59:60 4:0:4:62:60 4:0:4:65:60
}

koda.lofi.loopBars vinylPadLoop1 at 1 for 12 {
  times 3
  from vinylPadRiff.notes -> source
}

koda.lofi.loopBars vinylPadLoop2 at 1 for 4 {
  times 1
  from vinylPadRiff.notes -> source
}

koda.lofi.arrange vinylPadPlan at 1 for 44 {
  s1 20bar
  s2 40bar
  from vinylPadLoop1.notes -> p1
  from vinylPadLoop2.notes -> p2
}

koda.lofi.vinylPad vinylPad at 1 for 44 {
  from vinylPadPlan.notes -> notes
}

midi-clip lofiLeadRiff at 1 for 4 {
  notes 1:0:1.5:81:88 1:2:1:79:84 2:0.5:2:76:86 3:0:1.5:77:88 3:2:1:74:84 4:0:3:71:86
}

koda.lofi.loopBars lofiLeadLoop1 at 1 for 20 {
  times 5
  from lofiLeadRiff.notes -> source
}

koda.lofi.arrange lofiLeadPlan at 1 for 44 {
  s1 20bar
  from lofiLeadLoop1.notes -> p1
}

koda.lofi.lofiLead lofiLead at 1 for 44 {
  from lofiLeadPlan.notes -> notes
}

# ------------------------------------------------------------------ the music
mixer music {
  inputs 4
  gains "-6 -6 -12 -9"
  from lofiBass.audio -> in1
  from lofiKeys.audio -> in2
  from vinylPad.audio -> in3
  from lofiLead.audio -> in4
}

# ------------------------------------------------------------------ the drums, voice by voice
drums kick1 at 5 for 36 {
  kit samples/kit
  pattern kick:x.....x...x.....
}

drums snare1 at 5 for 36 {
  kit samples/kit
  pattern snare:....x.......x...
}

drums hat1 at 1 for 44 {
  kit samples/kit
  pattern hat:x.x.x.x.x.x.x.xx
}

drums open1 at 21 for 12 {
  kit samples/kit
  pattern open:......x.......x.
}

mixer kicks {
  inputs 4
  gains "0 0 0 0"
  from kick1.audio -> audio1
}

mixer snares {
  inputs 4
  gains "-2 0 0 0"
  from snare1.audio -> audio1
}

mixer hats {
  inputs 4
  gains "-2 -7 0 0"
  from hat1.audio -> audio1
  from open1.audio -> audio2
}

koda.lofi.drumBus drumBus {
  from kicks.mix -> kick
  from snares.mix -> snare
  from hats.mix -> hats
  from kicks.mix -> perc
}

# ------------------------------------------------------------------ the mix
mixer final {
  inputs 4
  gains "14 13 0 0"
  from drumBus.audio -> in1
  from music.audio -> audio2
}

koda.lofi.master finish {
  from final.mix -> audio
}

master out {
  from finish.audio -> mix
}
