/** The finishing touch: tilt, glue, width and a ceiling. */
#[DisplayName("Drum and bass master")]
#[Category("Drum and bass")]
#[Tags("master", "limiter", "glue", "width", "dnb")]
component koda.dnb.master version 1.0.0 current {
  id "demo.koda.dnb.master"

  input audio: Audio

  #[DisplayName("Glue"), MinValue(-30dB), MaxValue(0dB)]
  property glue: Gain = -12dB

  #[DisplayName("Width"), MinValue(50), MaxValue(150)]
  property width: Int = 112

  #[DisplayName("Ceiling"), MinValue(-6dB), MaxValue(0dB)]
  property ceiling: Gain = -1dB

  output audio: Audio

  ui {
    row {
      knob glue size l tint purple
      knob width size l tint teal
      knob ceiling tint red
    }
    card {
      knob glue size s tint purple
      knob width size s tint teal
    }
  }

  process {
    emit audio
      |> eq(low=1dB, high=1dB, low_hz=70Hz, high_hz=6000Hz)
      |> compressor(threshold=glue, ratio=2, attack=20ms, release=140ms)
      |> width(width=width)
      |> limiter(ceiling=ceiling)
  }
}
