{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AMPLE",
  "scopeName": "source.amplet",
  "comment": "Generated by tools/gen-editor-assets.mjs from spec . Do not edit by hand.",
  "fileTypes": [
    "amplet"
  ],
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#view"
    },
    {
      "include": "#block"
    },
    {
      "include": "#layout"
    },
    {
      "include": "#directive"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.amplet",
      "match": "#.*$"
    },
    "string": {
      "name": "string.quoted.double.amplet",
      "match": "\"(?:[^\"\\\\]|\\\\.)*\""
    },
    "number": {
      "name": "constant.numeric.amplet",
      "match": "-?\\b[0-9]+(?:\\.[0-9]+)?\\b"
    },
    "classVersion": {
      "match": "\\b(stable|pinned|live)(@)([0-9]+(?:\\.[0-9]+)*)",
      "captures": {
        "1": {
          "name": "storage.type.class.amplet"
        },
        "2": {
          "name": "punctuation.separator.amplet"
        },
        "3": {
          "name": "constant.numeric.version.amplet"
        }
      }
    },
    "headerKeyword": {
      "name": "keyword.control.amplet",
      "match": "\\b(at|for|as|bake|lock|refresh|freeze|seeds|plan)\\b"
    },
    "directive": {
      "match": "^(composition|project|features|lint|assist)\\b(.*)$",
      "name": "meta.directive.amplet",
      "captures": {
        "1": {
          "name": "keyword.control.directive.amplet"
        },
        "2": {
          "patterns": [
            {
              "include": "#inlineKeyword"
            },
            {
              "include": "#string"
            },
            {
              "include": "#number"
            },
            {
              "include": "#comment"
            }
          ]
        }
      }
    },
    "inlineKeyword": {
      "name": "keyword.other.amplet",
      "match": "\\b(tempo|master\\-seed|on|off|diff|button|auto)\\b"
    },
    "view": {
      "name": "meta.view.amplet",
      "begin": "^(view)\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.directive.amplet"
        },
        "2": {
          "name": "punctuation.definition.block.begin.amplet"
        }
      },
      "end": "^(\\})",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.block.end.amplet"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "match": "^\\s*(section|line|order|group|size|pin|member|title|label|x|y)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.directive.amplet"
            }
          }
        },
        {
          "match": "\\b(at|for)\\b",
          "name": "keyword.other.amplet"
        },
        {
          "include": "#string"
        },
        {
          "include": "#number"
        }
      ]
    },
    "layout": {
      "match": "^(layout)\\s+(\"(?:[^\"\\\\]|\\\\.)*\"|[A-Za-z0-9_-]+)\\s+(-?[0-9]+)\\s+(-?[0-9]+)",
      "captures": {
        "1": {
          "name": "keyword.control.directive.amplet"
        },
        "2": {
          "name": "variable.other.declaration.amplet"
        },
        "3": {
          "name": "constant.numeric.amplet"
        },
        "4": {
          "name": "constant.numeric.amplet"
        }
      }
    },
    "from": {
      "match": "^\\s*(from)\\s+(\"(?:[^\"\\\\]|\\\\.)*\"|[A-Za-z0-9_-]+)(\\.)(\"(?:[^\"\\\\]|\\\\.)*\"|[A-Za-z0-9_-]+)\\s*(->)\\s*(\"(?:[^\"\\\\]|\\\\.)*\"|[A-Za-z0-9_-]+)",
      "captures": {
        "1": {
          "name": "keyword.control.from.amplet"
        },
        "2": {
          "name": "variable.other.block.amplet"
        },
        "3": {
          "name": "punctuation.accessor.amplet"
        },
        "4": {
          "name": "variable.other.property.amplet"
        },
        "5": {
          "name": "keyword.operator.arrow.amplet"
        },
        "6": {
          "name": "variable.parameter.amplet"
        }
      }
    },
    "parameter": {
      "match": "^\\s*([A-Za-z0-9_-]+)(?=\\s|$)",
      "captures": {
        "1": {
          "name": "entity.other.attribute-name.parameter.amplet"
        }
      }
    },
    "block": {
      "name": "meta.block.amplet",
      "begin": "^(ace\\-music|ai\\-voice|ambience|arpeggiator|autotune|bass|bitcrusher|bus|choir|chop|chord|chorus|click|compressor|convolution|crossfade|curve|cut|deesser|delay|delay\\-llama|denoise|distortion|drums|duck|eq|fade|filter|fire|flanger|follow|gate|gm|granular|group|guitar|import\\-audio|join|limiter|lyrics|map|master|meter|midi|midi\\-clip|midi\\-humanize|midi\\-render|mixer|mood\\-scene|normalize|pan|peq|phaser|piano|pitch|quantize|region\\-merge|reverb|reverse|rewind|sampler|scorer|scratch|send|sequencer|shift|silence|splitter|stretch|synth|transpose|tremolo|trim|variants|vocoder|voice\\-clone|volume|width)\\s+(\"(?:[^\"\\\\]|\\\\.)*\"|[A-Za-z0-9_-]+)([^{#\\n]*)(\\{)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.type.block.amplet"
        },
        "2": {
          "name": "variable.other.declaration.amplet"
        },
        "3": {
          "patterns": [
            {
              "include": "#classVersion"
            },
            {
              "include": "#headerKeyword"
            },
            {
              "include": "#string"
            },
            {
              "include": "#number"
            }
          ]
        },
        "4": {
          "name": "punctuation.definition.block.begin.amplet"
        }
      },
      "end": "^\\s*(\\})",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.block.end.amplet"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#from"
        },
        {
          "include": "#parameter"
        },
        {
          "include": "#string"
        },
        {
          "include": "#number"
        }
      ]
    }
  }
}
