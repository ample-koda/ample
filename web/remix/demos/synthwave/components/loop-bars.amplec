/** Repeats a riff: a short pattern becomes a whole section. */
#[DisplayName("Loop bars")]
#[Category("Synthwave")]
#[Tags("loop", "repeat", "arrangement", "synthwave")]
component koda.synthwave.loopBars version 1.0.0 current {
  id "demo.koda.synthwave.loop-bars"

  input source: Notes

  #[DisplayName("Times"), MinValue(1), MaxValue(64), Step(1)]
  property times: Int = 8

  output notes: Notes

  ui {
    knob times tint teal
    card {
      knob times size s tint teal
    }
  }

  process {
    emit source |> repeat(times)
  }
}
