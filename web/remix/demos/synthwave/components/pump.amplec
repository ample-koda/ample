/** The sidechain pump: what goes through it ducks on the beat. */
#[DisplayName("Pump")]
#[Category("Synthwave")]
#[Tags("sidechain", "pump", "duck", "dynamics", "synthwave")]
component koda.synthwave.pump version 1.0.0 current {
  id "demo.koda.synthwave.pump"

  input audio: Audio

  #[DisplayName("Depth"), MinValue(0dB), MaxValue(24dB)]
  property depth: Gain = 4dB

  #[DisplayName("Release (ms)"), MinValue(40), MaxValue(500)]
  property release: Int = 220

  output audio: Audio

  ui {
    row {
      knob depth size l tint blue
      knob release size l tint teal
    }
    card {
      knob depth size s tint blue
      knob release size s tint teal
    }
  }

  process {
    emit audio
      |> duck(depth=depth, release=release * 1ms, pattern="x...x...x...x...")
  }
}
