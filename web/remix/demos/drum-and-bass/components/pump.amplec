/** The sidechain pump: what goes through it ducks on the beat. */
#[DisplayName("Pump")]
#[Category("Drum and bass")]
#[Tags("sidechain", "pump", "duck", "dynamics", "dnb")]
component koda.dnb.pump version 1.0.0 current {
  id "demo.koda.dnb.pump"

  input audio: Audio

  #[DisplayName("Depth"), MinValue(0dB), MaxValue(24dB)]
  property depth: Gain = 5dB

  #[DisplayName("Release (ms)"), MinValue(40), MaxValue(500)]
  property release: Int = 120

  output audio: Audio

  ui {
    row {
      knob depth size l tint blue
      knob release size l tint teal
    }
    card {
      knob depth size s tint blue
      knob release size s tint teal
    }
  }

  process {
    emit audio
      |> duck(depth=depth, release=release * 1ms, pattern="x.........x.....")
  }
}
