composition "Iron Furnace" { ample 1  tempo 140  master-seed 666 }

# IRON FURNACE: heavy metal in E minor at 140 BPM, 32 bars (about 55 seconds).
#
#   bars  1- 4  intro      the galloping riff alone
#   bars  5-12  verse      + bass and drums (eighth-note double kick)
#   bars 13-20  chorus     big open power chords and a singing lead
#   bars 21-24  bridge     a broken kick pattern (euclid: 5 hits spread over 8 steps)
#   bars 25-32  final      the riff with everything, the lead on top
#
# Every guitar note is written as one low note; the helper power turns it into a power chord (root, fifth, octave),
# the sound of the style. The distortion block does the rest.
#
# TRY: drive 22 dB in the block crunch to 12 dB for classic rock, 30 dB for doom.
# TRY: euclid(5, 8, ...) in the clip bridgeKick to euclid(3, 8, ...) or euclid(7, 16, ...).

/**
 * Power chords: every note with its fifth and its octave on top.
 * @param roots the low notes of the riff
 */
helper power(Notes roots) -> Notes {
  return roots |> merge(roots |> transpose(7)) |> merge(roots |> transpose(12))
}

# ---- the riffs: one note per hit, power gives them their weight -------------------------------------
# the gallop: one eighth and two sixteenths on every beat (E for a bar, then G and A)
midi-clip gallop at 1 for 2 {
  notes "1:0:0.45:40:118 1:0.5:0.2:40:96 1:0.75:0.2:40:100 1:1:0.45:40:118 1:1.5:0.2:40:96 1:1.75:0.2:40:100 1:2:0.45:40:118 1:2.5:0.2:40:96 1:2.75:0.2:40:100 1:3:0.45:40:118 1:3.5:0.2:40:96 1:3.75:0.2:40:100 2:0:0.45:43:118 2:0.5:0.2:43:96 2:0.75:0.2:43:100 2:1:0.45:43:118 2:1.5:0.2:43:96 2:1.75:0.2:43:100 2:2:0.45:45:118 2:2.5:0.2:45:96 2:2.75:0.2:45:100 2:3:0.45:45:118 2:3.5:0.2:47:110 2:3.75:0.2:47:110"
}
# the chorus: C, D, E, E as long open chords
midi-clip open at 1 for 4 {
  notes "1:0:4:36:118 2:0:4:38:118 3:0:4:40:120 4:0:3:40:116 4:3:1:43:110"
}
# the lead over the chorus
midi-clip melody at 1 for 4 {
  notes "1:0:1:76:110 1:1:1:74:104 1:2:2:71:108 2:0:1:74:106 2:1:1:76:108 2:2:2:79:114 3:0:1:78:110 3:1:1:76:104 3:2:1:74:104 3:3:1:71:100 4:0:4:76:116"
}
# the drums of the verse: double kick on every eighth, snare on two and four, the ride on the beat
midi-clip verseBeat at 1 for 1 {
  notes "1:0:0.2:36:118 1:0.5:0.2:36:104 1:1:0.2:36:118 1:1.5:0.2:36:104 1:2:0.2:36:118 1:2.5:0.2:36:104 1:3:0.2:36:118 1:3.5:0.2:36:104 1:1:0.3:38:120 1:3:0.3:38:120 1:0:0.3:51:84 1:1:0.3:51:76 1:2:0.3:51:84 1:3:0.3:51:76"
}
# the chorus beat: a crash on the one, half-time snare
midi-clip chorusBeat at 1 for 1 {
  notes "1:0:0.2:36:120 1:0.5:0.2:36:100 1:1.5:0.2:36:100 1:2:0.3:38:124 1:2.5:0.2:36:100 1:3:0.2:36:104 1:3.5:0.2:36:100 1:0:1:49:110 1:0:0.2:42:70 1:1:0.2:42:70 1:2:0.2:42:70 1:3:0.2:42:70"
}
midi-clip snareBack at 1 for 1 {
  notes "1:1:0.3:38:116 1:3:0.3:38:116 1:0:0.2:42:70 1:1:0.2:42:70 1:2:0.2:42:70 1:3:0.2:42:70"
}

# ---- the arrangement ------------------------------------------------------------------------------
midi-clip guitarPart at 1 for 32 {
  notes power(gallop.notes) |> repeat(6) |> concat(power(open.notes) |> repeat(2)) |> concat(power(gallop.notes) |> repeat(6))
}
midi-clip bassPart at 5 for 28 {
  notes gallop.notes |> repeat(4) |> concat(open.notes |> repeat(2)) |> concat(gallop.notes |> repeat(6))
}
midi-clip leadPart at 13 for 20 {
  notes melody.notes |> repeat(2) |> concat(melody.notes |> transpose(-12) |> shift(4bars) |> merge(melody.notes |> shift(8bars)))
}
midi-clip bridgeKick at 21 for 4 {
  notes euclid(5, 8, pitch=36, step=0.5beat) |> repeat(4)
}
midi-clip drumPart at 5 for 28 {
  notes verseBeat.notes |> repeat(8) |> concat(chorusBeat.notes |> repeat(8)) |> concat(snareBack.notes |> repeat(4)) |> concat(verseBeat.notes |> repeat(8))
}

# ---- the band (General MIDI) ----------------------------------------------------------------------
gm rhythm at 1 for 32 {
  file pack:musescore-general
  program 30
  gain -14 dB
  from guitarPart.notes -> notes
}
gm leadGuitar at 13 for 20 {
  file pack:musescore-general
  program 29
  gain -13 dB
  from leadPart.notes -> notes
}
gm bassGuitar at 5 for 28 {
  file pack:musescore-general
  program 34
  gain -8 dB
  from bassPart.notes -> notes
}
gm drums at 5 for 28 {
  file pack:musescore-general
  program 0
  channel 9
  gain -6 dB
  from drumPart.notes -> notes
}
gm bridgeDrums at 21 for 4 {
  file pack:musescore-general
  program 0
  channel 9
  gain -6 dB
  from bridgeKick.notes -> notes
}

# ---- the furnace: distortion on the guitars, a short room ----------------------------------------
mixer guitars {
  inputs 2
  gains "0 -2"
  from rhythm.audio -> audio1
  from leadGuitar.audio -> audio2
}
distortion crunch {
  drive 22 dB
  mode hard
  tone 5500 Hz
  level -8 dB
  from guitars.audio -> audio
}
mixer stage {
  inputs 4
  gains "0 0 0 0"
  from crunch.audio -> audio1
  from bassGuitar.audio -> audio2
  from drums.audio -> audio3
  from bridgeDrums.audio -> audio4
}
reverb room {
  size 30%
  decay 35%
  mix 12%
  from stage.audio -> audio
}
limiter brick {
  from room.audio -> audio
}
master out {
  from brick.audio -> audio
}
