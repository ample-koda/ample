composition "hello melody" { ample 1  tempo 110  master-seed 1 }

# Your first AMPLE song. A clip holds notes: bar:beat:length:pitch:velocity (pitch 60 is the middle C).
midi-clip tune at 1 for 4 {
  notes 1:0:1:60:100 1:1:1:64:100 1:2:1:67:100 1:3:1:72:100 2:0:2:71:100 2:2:2:67:100 3:0:1:65:100 3:1:1:69:100 3:2:1:72:100 3:3:1:77:100 4:0:4:76:100
}

# A synth plays the notes of the clip. Change the wave (sine, triangle, saw, square) or the cutoff and build again.
synth lead at 1 for 4 {
  wave saw
  attack 10 ms
  decay 200 ms
  sustain 60
  release 300 ms
  cutoff 3500 Hz
  from tune.notes -> notes
}

master out {
  from lead.audio -> audio
}
