# ------------------------------------------------------------------ drums (General MIDI percussion on channel 10, which is 9 counting from 0)
# Only the kick, four to the floor.
midi-clip beat_kick at 1 for 4 {
  notes 1:0:0.25:36:118 1:1:0.25:36:118 1:2:0.25:36:118 1:3:0.25:36:118 2:0:0.25:36:118 2:1:0.25:36:118 2:2:0.25:36:118 2:3:0.25:36:118 3:0:0.25:36:118 3:1:0.25:36:118 3:2:0.25:36:118 3:3:0.25:36:118 4:0:0.25:36:118 4:1:0.25:36:118 4:2:0.25:36:118 4:3:0.25:36:118
  bars 4
}
