# Only hats.
midi-clip beat_hats at 1 for 8 {
  notes 1:0:0.2:42:70 1:0.5:0.2:42:52 1:1:0.2:42:70 1:1.5:0.2:42:52 1:2:0.2:42:70 1:2.5:0.2:42:52 1:3:0.2:42:70 1:3.5:0.2:42:52 2:0:0.2:42:70 2:0.5:0.2:42:52 2:1:0.2:42:70 2:1.5:0.2:42:52 2:2:0.2:42:70 2:2.5:0.2:42:52 2:3:0.2:42:70 2:3.5:0.2:42:52 3:0:0.2:42:70 3:0.5:0.2:42:52 3:1:0.2:42:70 3:1.5:0.2:42:52 3:2:0.2:42:70 3:2.5:0.2:42:52 3:3:0.2:42:70 3:3.5:0.2:42:52 4:0:0.2:42:70 4:0.5:0.2:42:52 4:1:0.2:42:70 4:1.5:0.2:42:52 4:2:0.2:42:70 4:2.5:0.2:42:52 4:3:0.2:42:70 4:3.5:0.2:42:52 5:0:0.2:42:70 5:0.5:0.2:42:52 5:1:0.2:42:70 5:1.5:0.2:42:52 5:2:0.2:42:70 5:2.5:0.2:42:52 5:3:0.2:42:70 5:3.5:0.2:42:52 6:0:0.2:42:70 6:0.5:0.2:42:52 6:1:0.2:42:70 6:1.5:0.2:42:52 6:2:0.2:42:70 6:2.5:0.2:42:52 6:3:0.2:42:70 6:3.5:0.2:42:52 7:0:0.2:42:70 7:0.5:0.2:42:52 7:1:0.2:42:70 7:1.5:0.2:42:52 7:2:0.2:42:70 7:2.5:0.2:42:52 7:3:0.2:42:70 7:3.5:0.2:42:52 8:0:0.2:42:70 8:0.5:0.2:42:52 8:1:0.2:42:70 8:1.5:0.2:42:52 8:2:0.2:42:70 8:2.5:0.2:42:52 8:3:0.2:42:70 8:3.5:0.2:42:52
  bars 8
}
# A snare roll that speeds up, then a crash.
midi-clip beat_roll at 1 for 3 {
  notes 1:0:0.2:38:60 1:0.5:0.2:38:62 1:1:0.2:38:64 1:1.5:0.2:38:66 1:2:0.2:38:68 1:2.5:0.2:38:70 1:3:0.2:38:72 1:3.5:0.2:38:74 2:0:0.2:38:92 2:0.25:0.2:38:94 2:0.5:0.2:38:96 2:0.75:0.2:38:98 2:1:0.2:38:100 2:1.25:0.2:38:102 2:1.5:0.2:38:104 2:1.75:0.2:38:106 2:2:0.2:38:108 2:2.25:0.2:38:110 2:2.5:0.2:38:112 2:2.75:0.2:38:114 2:3:0.2:38:116 2:3.25:0.2:38:118 2:3.5:0.2:38:120 2:3.75:0.2:38:122 3:0:2:49:110
  bars 3
}
midi-clip drum_notes at 1 for 60 {
  notes beat_hats.notes |> shift(0bars) |> merge(beat_kick.notes |> shift(4bars)) |> merge(beat_full.notes |> shift(8bars)) |> merge(beat_full.notes |> shift(16bars)) |> merge(beat_full.notes |> shift(24bars)) |> merge(beat_hats.notes |> shift(32bars)) |> merge(beat_roll.notes |> shift(38bars)) |> merge(beat_full.notes |> shift(40bars)) |> merge(beat_full.notes |> shift(48bars))
}

gm drums at 1 for 60 {
  file pack:musescore-general
  program 0
  channel 9
  gain -8 dB
  from drum_notes.notes -> notes
}

# ------------------------------------------------------------------ the sound: pump, echo, room, mix
# The pump: the music dips at every kick (sidechain), like a heart beating. depth is how far, release how fast it comes back.
mixer music {
  gains 0 0 0 0
  from piano.audio -> audio1
  from pad.audio -> audio2
  from stab.audio -> audio3
  from bass.audio -> audio4
}

duck pump {
  depth 9 dB
  release 120 ms
  pattern x...x...x...x...
  from music.audio -> audio
}

# The lead gets an echo (three sixteenths at 175 BPM is about 257 ms) and a little room.
delay echo {
  time 257 ms
  feedback 30 %
  mix 22 %
  from lead.audio -> audio
}

reverb room {
  size 45 %
  decay 50 %
  mix 14 %
  from echo.audio -> audio
}

mixer band {
  gains 6 6 6
  from pump.audio -> audio1
  from room.audio -> audio2
  from drums.audio -> audio3
}

# Nothing may clip: the limiter keeps everything under -1 dB.
limiter safe {
  ceiling -1 dB
  from band.audio -> audio
}

# master "out": what reaches the master is what you hear. Every song has exactly one.
master out {
  from safe.audio -> audio
}

# ------------------------------------------------------------------ where the blocks sit on the canvas: together they make a big A on the minimap
# (the master is the top of the A, the two legs run down and out with the blocks close together, the crossbar is the bass). The studio's "Auto format" would arrange them differently.
layout out 1520 40
layout safe 1360 208
layout band 1250 396
layout pump 1140 624
layout music 1030 812
layout piano 920 1040
layout piano_notes 810 1288
layout piano_held8 700 1434
layout piano_stabs 590 1580
layout pad 480 1726
layout pad_notes 370 1894
layout pad_held8 260 2040
layout stab 150 2186
layout stab_notes 40 2354
layout room 1680 208
layout echo 1790 396
layout lead 1900 584
layout lead_notes 2010 752
layout hook_16 2120 898
layout hook_up_16 2230 1044
layout hook_sparse 2340 1190
layout drums 2450 1336
layout drum_notes 2560 1584
layout beat_full 2670 1730
layout beat_kick 2780 1876
layout beat_hats 2890 2022
layout beat_roll 3000 2168
layout stab_8 1055 1434
layout bass_8 1365 1434
layout bass_notes 1675 1434
layout bass 1985 1434
