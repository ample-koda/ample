/** Notes in, a lush pad for the breakdown out. */
#[DisplayName("Trance pad")]
#[Category("Trance")]
#[Tags("pad", "trance", "instrument", "trance")]
component koda.trance.trancePad version 1.0.0 current {
  id "demo.koda.trance.trance-pad"

  input notes: Notes

  #[DisplayName("Brightness"), MinValue(400), MaxValue(5000)]
  property brightness: Int = 2000

  #[DisplayName("Level"), MinValue(-30dB), MaxValue(6dB)]
  property level: Gain = -10dB

  output audio: Audio

  ui {
    row {
      knob brightness size l tint purple
      knob level size l tint gray
    }
    card {
      knob brightness size s tint purple
      knob level size s tint gray
    }
    preview live
  }

  process {
    emit notes
      |> synth(wave="saw", attack="900 ms", decay="500 ms", sustain="85", release="1400 ms")
      |> filter(type="lowpass", cutoff=brightness * 1Hz)
      |> reverb(size=85%, decay=80%, mix=38%)
      |> gain(level)
  }
}
