/** A delay into a reverb: one block for the user, two processors inside. */
#[DisplayName("Dream echo")]
#[Category("Audio effects")]
#[Tags("echo", "space", "reverb", "delay")]
component koda.fx.dreamEcho version 1.0.0 current {
  id "demo.koda.fx.dream-echo"

  input audio: Audio

  #[MinValue(0%), MaxValue(90%)]
  property feedback: Percent = 30%

  property delayTime: Duration = 0.25beat

  #[MinValue(0%), MaxValue(100%)]
  property room: Percent = 40%

  output audio: Audio

  ui {
    row {
      knob feedback label "Echo" size l tint orange
      knob room label "Room" size l tint blue
    }
    field delayTime
    meter audio
    card {
      knob feedback size s
      knob room size s
    }
    preview live
  }

  process {
    emit audio
      |> delay(time=delayTime, feedback=feedback)
      |> reverb(size=room)
  }
}
