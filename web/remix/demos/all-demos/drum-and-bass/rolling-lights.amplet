composition "drum and bass" { ample 1  tempo 174  master-seed 174 }

# DRUM AND BASS: liquid drum and bass, 88 bars at 174 BPM (2:01), made of custom components.
#
#   bars  1- 8  intro
#   bars  9-16  build
#   bars 17-40  drop
#   bars 41-48  breakdown
#   bars 49-80  drop2
#   bars 81-88  outro
#
# Components (techno-style: Notes components arrange the riffs, instruments are Notes in / sound out, the rest are audio components): loopBars, arrange, reeseBass, liquidKeys, dnbPad, dnbLead, drumBus, pump, master.
# The drums need the kit in samples/kit (kick, snare, hat, open, tom).
import "drum-and-bass/components/loop-bars.amplec"
import "drum-and-bass/components/arrange.amplec"
import "drum-and-bass/components/reese-bass.amplec"
import "drum-and-bass/components/liquid-keys.amplec"
import "drum-and-bass/components/dnb-pad.amplec"
import "drum-and-bass/components/dnb-lead.amplec"
import "drum-and-bass/components/drum-bus.amplec"
import "drum-and-bass/components/pump.amplec"
import "drum-and-bass/components/master.amplec"

# ------------------------------------------------------------------ riffs, loops and the arrangement of every instrument
midi-clip reeseBassRiff at 1 for 4 {
  notes 1:0:1.5:29:105 1:1.5:0.5:29:95 1:2.5:1.5:36:100 2:0:1.5:26:105 2:1.5:0.5:26:95 2:2.5:1.5:33:100 3:0:1.5:31:105 3:1.5:0.5:31:95 3:2.5:1.5:38:100 4:0:1.5:24:105 4:1.5:0.5:24:95 4:2.5:1.5:31:100
}

koda.dnb.loopBars reeseBassLoop1 at 1 for 24 {
  times 6
  from reeseBassRiff.notes -> source
}

koda.dnb.loopBars reeseBassLoop2 at 1 for 32 {
  times 8
  from reeseBassRiff.notes -> source
}

koda.dnb.arrange reeseBassPlan at 1 for 88 {
  s1 16bar
  s2 48bar
  from reeseBassLoop1.notes -> p1
  from reeseBassLoop2.notes -> p2
}

koda.dnb.reeseBass reeseBass at 1 for 88 {
  from reeseBassPlan.notes -> notes
}

midi-clip liquidKeysRiff at 1 for 4 {
  notes 1:0:0.75:53:84 1:0:0.75:56:84 1:0:0.75:60:84 1:0:0.75:63:84 1:1.5:0.5:53:78 1:1.5:0.5:56:78 1:1.5:0.5:60:78 1:1.5:0.5:63:78 1:3:0.75:53:84 1:3:0.75:56:84 1:3:0.75:60:84 1:3:0.75:63:84 2:0:0.75:50:84 2:0:0.75:54:84 2:0:0.75:57:84 2:0:0.75:61:84 2:1.5:0.5:50:78 2:1.5:0.5:54:78 2:1.5:0.5:57:78 2:1.5:0.5:61:78 2:3:0.75:50:84 2:3:0.75:54:84 2:3:0.75:57:84 2:3:0.75:61:84 3:0:0.75:55:84 3:0:0.75:60:84 3:0:0.75:62:84 3:1.5:0.5:55:78 3:1.5:0.5:60:78 3:1.5:0.5:62:78 3:3:0.75:55:84 3:3:0.75:60:84 3:3:0.75:62:84 4:0:0.75:48:84 4:0:0.75:51:84 4:0:0.75:55:84 4:0:0.75:58:84 4:1.5:0.5:48:78 4:1.5:0.5:51:78 4:1.5:0.5:55:78 4:1.5:0.5:58:78 4:3:0.75:48:84 4:3:0.75:51:84 4:3:0.75:55:84 4:3:0.75:58:84
}

koda.dnb.loopBars liquidKeysLoop1 at 1 for 40 {
  times 10
  from liquidKeysRiff.notes -> source
}

koda.dnb.loopBars liquidKeysLoop2 at 1 for 40 {
  times 10
  from liquidKeysRiff.notes -> source
}

koda.dnb.arrange liquidKeysPlan at 1 for 88 {
  s1 0bar
  s2 48bar
  from liquidKeysLoop1.notes -> p1
  from liquidKeysLoop2.notes -> p2
}

koda.dnb.liquidKeys liquidKeys at 1 for 88 {
  from liquidKeysPlan.notes -> notes
}

midi-clip dnbPadRiff at 1 for 8 {
  notes 1:0:4:53:68;tie=1 2:0:4:53:68;tie=1 1:0:4:56:68;tie=2 2:0:4:56:68;tie=2 1:0:4:60:68;tie=3 2:0:4:60:68;tie=3 1:0:4:63:68;tie=4 2:0:4:63:68;tie=4 3:0:4:50:68;tie=5 4:0:4:50:68;tie=5 3:0:4:54:68;tie=6 4:0:4:54:68;tie=6 3:0:4:57:68;tie=7 4:0:4:57:68;tie=7 3:0:4:61:68;tie=8 4:0:4:61:68;tie=8 5:0:4:55:68;tie=9 6:0:4:55:68;tie=9 5:0:4:60:68;tie=10 6:0:4:60:68;tie=10 5:0:4:62:68;tie=11 6:0:4:62:68;tie=11 7:0:4:48:68;tie=12 8:0:4:48:68;tie=12 7:0:4:51:68;tie=13 8:0:4:51:68;tie=13 7:0:4:55:68;tie=14 8:0:4:55:68;tie=14 7:0:4:58:68;tie=15 8:0:4:58:68;tie=15
}

koda.dnb.loopBars dnbPadLoop1 at 1 for 16 {
  times 2
  from dnbPadRiff.notes -> source
}

koda.dnb.loopBars dnbPadLoop2 at 1 for 40 {
  times 5
  from dnbPadRiff.notes -> source
}

koda.dnb.arrange dnbPadPlan at 1 for 88 {
  s1 0bar
  s2 40bar
  from dnbPadLoop1.notes -> p1
  from dnbPadLoop2.notes -> p2
}

koda.dnb.dnbPad dnbPad at 1 for 88 {
  from dnbPadPlan.notes -> notes
}

midi-clip dnbLeadRiff at 1 for 4 {
  notes 1:0:1.5:72:94 1:2:1:68:90 2:0:2:77:98 3:0:1.5:75:94 3:2:1:72:90 4:0:3:74:96
}

koda.dnb.loopBars dnbLeadLoop1 at 1 for 40 {
  times 10
  from dnbLeadRiff.notes -> source
}

koda.dnb.arrange dnbLeadPlan at 1 for 88 {
  s1 40bar
  from dnbLeadLoop1.notes -> p1
}

koda.dnb.dnbLead dnbLead at 1 for 88 {
  from dnbLeadPlan.notes -> notes
}

# ------------------------------------------------------------------ the music
mixer music {
  inputs 4
  gains "-5 -9 -11 -10"
  from reeseBass.audio -> audio1
  from liquidKeys.audio -> audio2
  from dnbPad.audio -> audio3
  from dnbLead.audio -> audio4
}

koda.dnb.pump pump {
  from music.audio -> audio
}

# ------------------------------------------------------------------ the drums, voice by voice
drums kick1 at 9 for 32 {
  kit samples/kit
  pattern kick:x.........x.....
}

drums kick2 at 49 for 32 {
  kit samples/kit
  pattern kick:x.........x.....
}

drums snare1 at 9 for 32 {
  kit samples/kit
  pattern snare:....x.......x...
}

drums snare2 at 49 for 40 {
  kit samples/kit
  pattern snare:....x.......x...
}

drums hat1 at 1 for 40 {
  kit samples/kit
  pattern hat:x.x.x.x.x.x.x.xx
}

drums hat2 at 49 for 40 {
  kit samples/kit
  pattern hat:x.x.x.x.x.x.x.xx
}

drums open1 at 17 for 24 {
  kit samples/kit
  pattern open:......x.......x.
}

drums open2 at 49 for 32 {
  kit samples/kit
  pattern open:......x.......x.
}

drums tom1 at 49 for 32 {
  kit samples/kit
  pattern tom:..............xx
}

mixer kicks {
  inputs 4
  gains "0 0 0 0"
  from kick1.audio -> audio1
  from kick2.audio -> audio2
}

mixer snares {
  inputs 4
  gains "0 0 0 0"
  from snare1.audio -> audio1
  from snare2.audio -> audio2
}

mixer hats {
  inputs 4
  gains "-3 -3 -7 -7"
  from hat1.audio -> audio1
  from hat2.audio -> audio2
  from open1.audio -> audio3
  from open2.audio -> audio4
}

mixer percs {
  inputs 4
  gains "-8 0 0 0"
  from tom1.audio -> audio1
}

koda.dnb.drumBus drumBus {
  from kicks.audio -> kick
  from snares.audio -> snare
  from hats.audio -> hats
  from percs.audio -> perc
}

# ------------------------------------------------------------------ the mix
mixer final {
  inputs 4
  gains "14 13 0 0"
  from drumBus.audio -> audio1
  from pump.audio -> audio2
}

koda.dnb.master finish {
  from final.audio -> audio
}

master out {
  from finish.audio -> audio
}
