composition "neon pulse" { ample 1  tempo 126  master-seed 20261029 }

# NEON PULSE: a modern techno track, 64 bars at 126 BPM in F minor (about 2 minutes), made of custom components.
#
#   bars  1-8   intro        kick, hats from bar 5
#   bars  9-16  build        + clap, open hat, acid bass, pad, a snare roll at the end
#   bars 17-32  drop         everything, stabs, the lead arpeggio from bar 25, a fill at bar 32
#   bars 33-40  break        no kick: pad, the lead melody, hats from 37, a roll into the drop
#   bars 41-56  drop 2       the full groove with more percussion and a variation of the stabs
#   bars 57-64  outro        kick, hats, bass and pad
#
# Components used (all in techno/components): loopBars and arrange (Notes in, Notes out: the arrangement is text, not a mouse),
# acidBass, stabs, pad and lead (Notes in, sound out: an instrument with its own effects, with knobs), drumBus (four audio inputs),
# pump (the sidechain), master. The drums need the kit in samples/kit (kick, snare, hat, open, tom).
import "techno/components/loop-bars.amplec"
import "techno/components/arrange.amplec"
import "techno/components/acid-bass.amplec"
import "techno/components/stabs.amplec"
import "techno/components/pad.amplec"
import "techno/components/lead.amplec"
import "techno/components/drum-bus.amplec"
import "techno/components/pump.amplec"
import "techno/components/master.amplec"

# ------------------------------------------------------------------ the riffs (one clip each, then looped and arranged)
midi-clip bassRiffA at 1 for 1 {
  notes 1:0:0.2:29:60 1:0.25:0.2:29:60 1:0.5:0.2:29:112 1:0.75:0.2:29:60 1:1:0.2:29:62 1:1.25:0.2:29:60 1:1.5:0.2:29:112 1:1.75:0.2:29:60 1:2:0.2:29:60 1:2.25:0.2:29:60 1:2.5:0.2:29:112 1:2.75:0.2:29:60 1:3:0.2:29:62 1:3.25:0.2:29:60 1:3.5:0.2:29:112 1:3.75:0.2:29:60
}

midi-clip bassRiffB at 1 for 2 {
  notes 1:0:0.2:29:60 1:0.25:0.2:29:60 1:0.5:0.2:41:112 1:0.75:0.2:29:60 1:1:0.2:29:62 1:1.25:0.2:32:60 1:1.5:0.2:29:112 1:1.75:0.2:41:60 1:2:0.2:29:60 1:2.25:0.2:29:60 1:2.5:0.2:41:112 1:2.75:0.2:29:60 1:3:0.2:36:62 1:3.25:0.2:29:60 1:3.5:0.2:41:112 1:3.75:0.2:29:60 2:0:0.2:29:60 2:0.25:0.2:29:60 2:0.5:0.2:29:112 2:0.75:0.2:41:60 2:1:0.2:29:62 2:1.25:0.2:34:60 2:1.5:0.2:29:112 2:1.75:0.2:41:60 2:2:0.2:29:60 2:2.25:0.2:29:60 2:2.5:0.2:29:112 2:2.75:0.2:41:60 2:3:0.2:37:62 2:3.25:0.2:29:60 2:3.5:0.2:29:112 2:3.75:0.2:41:60
}

midi-clip stabRiffA at 1 for 4 {
  notes 1:0.5:0.2:53:96 1:0.5:0.2:56:96 1:0.5:0.2:60:96 1:0.5:0.2:63:96 1:1.5:0.2:53:96 1:1.5:0.2:56:96 1:1.5:0.2:60:96 1:1.5:0.2:63:96 1:2.5:0.2:53:96 1:2.5:0.2:56:96 1:2.5:0.2:60:96 1:2.5:0.2:63:96 1:3.5:0.2:53:96 1:3.5:0.2:56:96 1:3.5:0.2:60:96 1:3.5:0.2:63:96 2:0.5:0.2:53:96 2:0.5:0.2:56:96 2:0.5:0.2:60:96 2:0.5:0.2:63:96 2:1.5:0.2:53:96 2:1.5:0.2:56:96 2:1.5:0.2:60:96 2:1.5:0.2:63:96 2:2.5:0.2:53:96 2:2.5:0.2:56:96 2:2.5:0.2:60:96 2:2.5:0.2:63:96 2:3.5:0.2:53:96 2:3.5:0.2:56:96 2:3.5:0.2:60:96 2:3.5:0.2:63:96 3:0.5:0.2:49:96 3:0.5:0.2:53:96 3:0.5:0.2:56:96 3:0.5:0.2:61:96 3:1.5:0.2:49:96 3:1.5:0.2:53:96 3:1.5:0.2:56:96 3:1.5:0.2:61:96 3:2.5:0.2:49:96 3:2.5:0.2:53:96 3:2.5:0.2:56:96 3:2.5:0.2:61:96 3:3.5:0.2:49:96 3:3.5:0.2:53:96 3:3.5:0.2:56:96 3:3.5:0.2:61:96 4:0.5:0.2:51:96 4:0.5:0.2:55:96 4:0.5:0.2:58:96 4:0.5:0.2:62:96 4:1.5:0.2:51:96 4:1.5:0.2:55:96 4:1.5:0.2:58:96 4:1.5:0.2:62:96 4:2.5:0.2:51:96 4:2.5:0.2:55:96 4:2.5:0.2:58:96 4:2.5:0.2:62:96 4:3.5:0.2:51:96 4:3.5:0.2:55:96 4:3.5:0.2:58:96 4:3.5:0.2:62:96
}

