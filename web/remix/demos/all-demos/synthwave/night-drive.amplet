composition "synthwave" { ample 1  tempo 100  master-seed 100 }

# SYNTHWAVE: retro synthwave, 56 bars at 100 BPM (2:14), made of custom components.
#
#   bars  1- 8  intro
#   bars  9-24  verse
#   bars 25-32  chorus
#   bars 33-40  bridge
#   bars 41-52  final
#   bars 53-56  outro
#
# Components (techno-style: Notes components arrange the riffs, instruments are Notes in / sound out, the rest are audio components): loopBars, arrange, analogBass, brassPad, neonArp, retroLead, drumBus, pump, master.
# The drums need the kit in samples/kit (kick, snare, hat, open, tom).
import "synthwave/components/loop-bars.amplec"
import "synthwave/components/arrange.amplec"
import "synthwave/components/analog-bass.amplec"
import "synthwave/components/brass-pad.amplec"
import "synthwave/components/neon-arp.amplec"
import "synthwave/components/retro-lead.amplec"
import "synthwave/components/drum-bus.amplec"
import "synthwave/components/pump.amplec"
import "synthwave/components/master.amplec"

# ------------------------------------------------------------------ riffs, loops and the arrangement of every instrument
midi-clip analogBassRiff at 1 for 4 {
  notes 1:0:0.4:45:100 1:0.5:0.4:45:85 1:1:0.4:45:100 1:1.5:0.4:45:85 1:2:0.4:45:100 1:2.5:0.4:45:85 1:3:0.4:45:100 1:3.5:0.4:45:85 2:0:0.4:41:100 2:0.5:0.4:41:85 2:1:0.4:41:100 2:1.5:0.4:41:85 2:2:0.4:41:100 2:2.5:0.4:41:85 2:3:0.4:41:100 2:3.5:0.4:41:85 3:0:0.4:36:100 3:0.5:0.4:36:85 3:1:0.4:36:100 3:1.5:0.4:36:85 3:2:0.4:36:100 3:2.5:0.4:36:85 3:3:0.4:36:100 3:3.5:0.4:36:85 4:0:0.4:43:100 4:0.5:0.4:43:85 4:1:0.4:43:100 4:1.5:0.4:43:85 4:2:0.4:43:100 4:2.5:0.4:43:85 4:3:0.4:43:100 4:3.5:0.4:43:85
}

koda.synthwave.loopBars analogBassLoop1 at 1 for 24 {
  times 6
  from analogBassRiff.notes -> source
}

koda.synthwave.loopBars analogBassLoop2 at 1 for 12 {
  times 3
  from analogBassRiff.notes -> source
}

koda.synthwave.arrange analogBassPlan at 1 for 56 {
  s1 8bar
  s2 40bar
  from analogBassLoop1.notes -> p1
  from analogBassLoop2.notes -> p2
}

koda.synthwave.analogBass analogBass at 1 for 56 {
  from analogBassPlan.notes -> notes
}

midi-clip brassPadRiff at 1 for 4 {
  notes 1:0:4:57:72 1:0:4:60:72 1:0:4:64:72 2:0:4:53:72 2:0:4:57:72 2:0:4:60:72 3:0:4:48:72 3:0:4:52:72 3:0:4:55:72 4:0:4:55:72 4:0:4:59:72 4:0:4:62:72
}

koda.synthwave.loopBars brassPadLoop1 at 1 for 56 {
  times 14
  from brassPadRiff.notes -> source
}

koda.synthwave.arrange brassPadPlan at 1 for 56 {
  s1 0bar
  from brassPadLoop1.notes -> p1
}

koda.synthwave.brassPad brassPad at 1 for 56 {
  from brassPadPlan.notes -> notes
}

midi-clip neonArpRiff at 1 for 4 {
  notes 1:0:0.2:69:94 1:0.25:0.2:72:84 1:0.5:0.2:76:84 1:0.75:0.2:72:84 1:1:0.2:69:94 1:1.25:0.2:72:84 1:1.5:0.2:76:84 1:1.75:0.2:72:84 1:2:0.2:69:94 1:2.25:0.2:72:84 1:2.5:0.2:76:84 1:2.75:0.2:72:84 1:3:0.2:69:94 1:3.25:0.2:72:84 1:3.5:0.2:76:84 1:3.75:0.2:72:84 2:0:0.2:65:94 2:0.25:0.2:69:84 2:0.5:0.2:72:84 2:0.75:0.2:69:84 2:1:0.2:65:94 2:1.25:0.2:69:84 2:1.5:0.2:72:84 2:1.75:0.2:69:84 2:2:0.2:65:94 2:2.25:0.2:69:84 2:2.5:0.2:72:84 2:2.75:0.2:69:84 2:3:0.2:65:94 2:3.25:0.2:69:84 2:3.5:0.2:72:84 2:3.75:0.2:69:84 3:0:0.2:60:94 3:0.25:0.2:64:84 3:0.5:0.2:67:84 3:0.75:0.2:64:84 3:1:0.2:60:94 3:1.25:0.2:64:84 3:1.5:0.2:67:84 3:1.75:0.2:64:84 3:2:0.2:60:94 3:2.25:0.2:64:84 3:2.5:0.2:67:84 3:2.75:0.2:64:84 3:3:0.2:60:94 3:3.25:0.2:64:84 3:3.5:0.2:67:84 3:3.75:0.2:64:84 4:0:0.2:67:94 4:0.25:0.2:71:84 4:0.5:0.2:74:84 4:0.75:0.2:71:84 4:1:0.2:67:94 4:1.25:0.2:71:84 4:1.5:0.2:74:84 4:1.75:0.2:71:84 4:2:0.2:67:94 4:2.25:0.2:71:84 4:2.5:0.2:74:84 4:2.75:0.2:71:84 4:3:0.2:67:94 4:3.25:0.2:71:84 4:3.5:0.2:74:84 4:3.75:0.2:71:84
}

koda.synthwave.loopBars neonArpLoop1 at 1 for 28 {
  times 7
  from neonArpRiff.notes -> source
}

koda.synthwave.arrange neonArpPlan at 1 for 56 {
  s1 24bar
  from neonArpLoop1.notes -> p1
}

koda.synthwave.neonArp neonArp at 1 for 56 {
  from neonArpPlan.notes -> notes
}

midi-clip retroLeadRiff at 1 for 4 {
  notes 1:0:1.5:76:98 1:2:1:72:92 2:0:3:69:96 3:0:1.5:79:98 3:2:1:76:92 4:0:3:74:98
}

koda.synthwave.loopBars retroLeadLoop1 at 1 for 8 {
  times 2
  from retroLeadRiff.notes -> source
}

koda.synthwave.loopBars retroLeadLoop2 at 1 for 12 {
  times 3
  from retroLeadRiff.notes -> source
}

koda.synthwave.arrange retroLeadPlan at 1 for 56 {
  s1 24bar
  s2 40bar
  from retroLeadLoop1.notes -> p1
  from retroLeadLoop2.notes -> p2
}

koda.synthwave.retroLead retroLead at 1 for 56 {
  from retroLeadPlan.notes -> notes
}

# ------------------------------------------------------------------ the music
mixer music {
  inputs 4
  gains "-5 -10 -11 -10"
  from analogBass.audio -> audio1
  from brassPad.audio -> audio2
  from neonArp.audio -> audio3
  from retroLead.audio -> audio4
}

koda.synthwave.pump pump {
  from music.audio -> audio
}

# ------------------------------------------------------------------ the drums, voice by voice
drums kick1 at 9 for 24 {
  kit samples/kit
  pattern kick:x...x...x...x...
}

drums kick2 at 41 for 12 {
  kit samples/kit
  pattern kick:x...x...x...x...
}

drums snare1 at 9 for 44 {
  kit samples/kit
  pattern snare:....x.......x...
}

drums hat1 at 9 for 24 {
  kit samples/kit
  pattern hat:x.x.x.x.x.x.x.x.
}

drums hat2 at 41 for 16 {
  kit samples/kit
  pattern hat:x.x.x.x.x.x.x.x.
}

drums open1 at 25 for 8 {
  kit samples/kit
  pattern open:..x...x...x...x.
}

drums open2 at 41 for 12 {
  kit samples/kit
  pattern open:..x...x...x...x.
}

drums tom1 at 33 for 8 {
  kit samples/kit
  pattern tom:x.x.x.x.x.x.x.x.
}

mixer kicks {
  inputs 4
  gains "0 0 0 0"
  from kick1.audio -> audio1
  from kick2.audio -> audio2
}

mixer snares {
  inputs 4
  gains "0 0 0 0"
  from snare1.audio -> audio1
}

mixer hats {
  inputs 4
  gains "-3 -3 -7 -7"
  from hat1.audio -> audio1
  from hat2.audio -> audio2
  from open1.audio -> audio3
  from open2.audio -> audio4
}

mixer percs {
  inputs 4
  gains "-5 0 0 0"
  from tom1.audio -> audio1
}

koda.synthwave.drumBus drumBus {
  from kicks.audio -> kick
  from snares.audio -> snare
  from hats.audio -> hats
  from percs.audio -> perc
}

# ------------------------------------------------------------------ the mix
mixer final {
  inputs 4
  gains "14 13 0 0"
  from drumBus.audio -> audio1
  from pump.audio -> audio2
}

koda.synthwave.master finish {
  from final.audio -> audio
}

master out {
  from finish.audio -> audio
}
