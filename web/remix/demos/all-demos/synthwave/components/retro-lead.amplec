/** Notes in, a soaring lead out. */
#[DisplayName("Retro lead")]
#[Category("Synthwave")]
#[Tags("lead", "synthwave", "instrument", "synthwave")]
component koda.synthwave.retroLead version 1.0.0 current {
  id "demo.koda.synthwave.retro-lead"

  input notes: Notes

  #[DisplayName("Brightness"), MinValue(800), MaxValue(7000)]
  property brightness: Int = 3500

  #[DisplayName("Level"), MinValue(-30dB), MaxValue(6dB)]
  property level: Gain = -9dB

  output audio: Audio

  ui {
    row {
      knob brightness size l tint orange
      knob level size l tint gray
    }
    card {
      knob brightness size s tint orange
      knob level size s tint gray
    }
    preview live
  }

  process {
    emit notes
      |> synth(wave="saw", attack="15 ms", decay="200 ms", sustain="75", release="300 ms")
      |> filter(type="lowpass", cutoff=brightness * 1Hz)
      |> delay(time=0.5beat, feedback=40%, mix=22%)
      |> reverb(size=60%, decay=50%, mix=20%)
      |> gain(level)
  }
}
