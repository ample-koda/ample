/** The sidechain pump: everything that goes through it ducks on every kick, so the music breathes with the beat. */
#[DisplayName("Kick pump")]
#[Category("Techno")]
#[Tags("sidechain", "pump", "duck", "techno", "dynamics")]
component koda.techno.pump version 1.0.0 current {
  id "demo.koda.techno.pump"

  input audio: Audio

  #[DisplayName("Depth"), MinValue(0dB), MaxValue(24dB)]
  property depth: Gain = 9dB

  #[DisplayName("Release (ms)"), MinValue(40), MaxValue(400)]
  property release: Int = 150

  output audio: Audio

  ui {
    row {
      knob depth size l tint blue
      knob release size l tint teal
    }
    card {
      knob depth size s tint blue
      knob release size s tint teal
    }
  }

  process {
    emit audio
      |> duck(depth=depth, release=release * 1ms, pattern="x...x...x...x...")
  }
}
