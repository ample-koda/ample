mixer voices {
  gains 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10
  pan -25% c 25% -25% c 25% -25% c 25% -25% c 25% -25% c 25%
  from slt_1.audio -> audio1
  from rms_1.audio -> audio2
  from awb_1.audio -> audio3
  from slt_2.audio -> audio4
  from rms_2.audio -> audio5
  from awb_2.audio -> audio6
  from slt_3.audio -> audio7
  from rms_3.audio -> audio8
  from awb_3.audio -> audio9
  from slt_4.audio -> audio10
  from rms_4.audio -> audio11
  from awb_4.audio -> audio12
  from slt_5.audio -> audio13
  from rms_5.audio -> audio14
  from awb_5.audio -> audio15
}

limiter tame {
  ceiling -6 dB
  lookahead 5 ms
  release 120 ms
  from voices.audio -> audio
}
reverb hall {
  size 30%
  decay 35%
  mix 14%
  from tame.audio -> audio
}
mixer band {
  gains -6 -5 -4 0
  pan c -15% 15% c
  from kit.audio -> audio1
  from accordion.audio -> audio2
  from bass.audio -> audio3
  from hall.audio -> audio4
}
master output {
  from band.audio -> audio
}
