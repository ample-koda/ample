# Demo song for the web UI parity tests.
composition "demo" { ample 1  tempo 92  master-seed 424242 }
midi-clip chords {
  chords Am F C G
  bars 8
}
drums drums at 1 for 16 as "beat A" {
}
bass bass {
  from chords.notes -> notes
}
piano piano pinned@2.0 at 1 for 8 as verse, 9 for 8 as chorus {
  from chords.notes -> notes
}
mixer mix {
  from drums.audio -> audio1
  from bass.audio -> audio2
  from piano.audio -> audio3
}
master master {
  from mix.audio -> audio
}
